<% content_for :title, t(".title") %>

<%= link_to t(".back"), friends_path(batch: true), class: "text-sm text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-200" %>

<div class="mt-4">
  <h1 class="text-2xl font-bold"><%= t(".heading") %></h1>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-300"><%= t(".description") %></p>

  <% if @creation.duplicate_count.positive? %>
    <%= render InlineNoticeComponent.new(class: "mt-4") do %>
      <%= t(".duplicates", count: @creation.duplicate_count) %>
    <% end %>
  <% end %>

  <% if @creation.errors.any? %>
    <%= render InlineNoticeComponent.new(class: "mt-4") do %>
      <%= t(".fix_errors") %>
    <% end %>
  <% end %>

  <%= form_with url: batch_friend_creation_path, scope: :batch_friend_creation, class: "mt-6" do %>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <%= render BatchFriendCandidateComponent.with_collection(@creation.candidates) %>
    </ul>
    <% if @creation.errors.added?(:candidates, :blank) %>
      <p class="mt-3 text-sm text-red-600 dark:text-red-400"><%= t(".selection_required") %></p>
    <% end %>
    <div class="mt-6 flex flex-wrap gap-2">
      <%= render ButtonComponent.new(type: :submit) do %><%= t(".submit") %><% end %>
      <%= link_to t(".start_over"), friends_path(batch: true),
            class: "rounded-lg px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700" %>
    </div>
  <% end %>
</div>
