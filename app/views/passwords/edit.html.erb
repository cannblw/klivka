<% content_for :title, t(".title") %>

<%= render CardComponent.new do %>
  <h1 class="text-xl font-bold"><%= t(".heading") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-4" do |form| %>
    <div class="space-y-3">
      <%= render InputFieldComponent.new(form, :password, type: :password,
            required: true, autocomplete: "new-password", maxlength: 72,
            placeholder: t(".password_placeholder")) %>
      <%= render InputFieldComponent.new(form, :password_confirmation, type: :password,
            required: true, autocomplete: "new-password", maxlength: 72,
            placeholder: t(".password_confirmation_placeholder")) %>
    </div>

    <div class="mt-4">
      <%= render ButtonComponent.new(type: :submit) { t(".submit") } %>
    </div>
  <% end %>
<% end %>
