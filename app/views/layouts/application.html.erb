<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= Current.user&.theme %>">
  <head>
    <title><%= content_for(:title) || "Klivka" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Klivka">
    <meta name="description" content="<%= t("brand.description") %>">
    <%= tag.meta name: "robots", content: "noindex, nofollow" if demo_mode? %>
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#EF6A2E">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Klivka">
    <meta property="og:title" content="<%= content_for(:title) || "Klivka" %>">
    <meta property="og:description" content="<%= t("brand.description") %>">
    <meta property="og:image" content="<%= image_url("/og-image.png") %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:title) || "Klivka" %>">
    <meta name="twitter:description" content="<%= t("brand.description") %>">
    <meta name="twitter:image" content="<%= image_url("/og-image.png") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-stone-100 text-stone-900 dark:bg-stone-900 dark:text-stone-100">
    <%= render DemoBannerComponent.new if demo_mode? %>
    <header class="border-b border-stone-200 bg-stone-50 dark:border-stone-700 dark:bg-stone-800">
      <div class="mx-auto flex min-h-14 max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2">
        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-4 gap-y-2">
          <%= link_to "/", aria: { label: t("brand.home_label") }, class: "shrink-0" do %>
            <%= render "application/logo" %>
          <% end %>
          <% if authenticated? %>
            <nav aria-label="<%= t("nav.primary") %>" class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <%= link_to t("nav.birthdays"), birthdays_path, class: "text-sm font-medium text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
              <%= link_to t("nav.contact_reminders"), contact_reminders_path, class: "text-sm font-medium text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
              <%= link_to t("nav.categories"), categories_path, class: "text-sm font-medium text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
            </nav>
          <% end %>
        </div>
        <% if authenticated? %>
          <div class="flex items-center gap-3">
            <%= link_to t("nav.settings"), settings_path, class: "text-sm font-medium text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
            <% unless demo_mode? %>
              <%= form_with url: session_path, method: :delete do %>
                <%= render ButtonComponent.new(type: :submit, variant: :ghost, size: :sm) do %>
                  <%= t("nav.sign_out") %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>
    <%= render TimeZoneSuggestionComponent.new(user: Current.user) if authenticated? %>
    <% if notice.present? || alert.present? %>
      <div id="flash" class="pointer-events-none fixed inset-x-4 top-4 z-50 flex flex-col items-center gap-2 sm:inset-x-auto sm:right-4 sm:items-end">
        <%= render FlashComponent.new(kind: :notice, message: notice) if notice.present? %>
        <%= render FlashComponent.new(kind: :alert, message: alert) if alert.present? %>
      </div>
    <% end %>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <%= yield %>
    </main>
    <%= render ConfirmDialogComponent.new(
          id: "discard-changes-dialog",
          title: t("discard_changes.title"),
          body: t("discard_changes.body"),
          confirm_label: t("discard_changes.discard"),
          cancel_label: t("discard_changes.keep_editing"),
          confirm_link_id: "discard-changes-confirm-link"
        ) %>

    <%= render ConfirmDialogComponent.new(
          id: "delete-entry-dialog",
          title: t("entries.delete_confirm_title"),
          body: t("entries.delete_confirm_body"),
          confirm_label: t("entries.delete"),
          cancel_label: t("entries.cancel"),
          confirm_link_id: "delete-entry-confirm-link",
          turbo_method: :delete
        ) %>

    <%= render ConfirmDialogComponent.new(
          id: "archive-person-dialog",
          title: t("people.archive_confirm.title"),
          body: t("people.archive_confirm.body"),
          confirm_label: t("people.archive_confirm.confirm"),
          cancel_label: t("people.archive_confirm.cancel"),
          confirm_link_id: "archive-person-confirm-link",
          destructive: false,
          turbo_method: :patch
        ) %>

    <%= render ConfirmDialogComponent.new(
          id: "delete-person-dialog",
          title: t("people.delete_confirm.title"),
          body: t("people.delete_confirm.body"),
          confirm_label: t("people.delete_confirm.confirm"),
          cancel_label: t("people.delete_confirm.cancel"),
          confirm_link_id: "delete-person-confirm-link",
          turbo_method: :delete
        ) %>
  </body>
</html>
