<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= Current.user&.theme %>">
  <head>
    <title><%= content_for(:title) || "Klivka" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Klivka">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#EF6A2E">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Klivka">
    <meta property="og:title" content="<%= content_for(:title) || "Klivka" %>">
    <meta property="og:image" content="<%= image_url("/og-image.png") %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:title) || "Klivka" %>">
    <meta name="twitter:image" content="<%= image_url("/og-image.png") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-stone-100 text-stone-900 dark:bg-stone-900 dark:text-stone-100">
    <header class="border-b border-stone-200 bg-stone-50 dark:border-stone-700 dark:bg-stone-800">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
        <div class="flex items-center gap-4">
          <%= link_to "/", aria: { label: t("brand.home_label") }, class: "shrink-0" do %>
            <%= image_tag "/brand/klivka-logo.svg", alt: t("brand.logo_alt"), class: "h-9 w-auto dark:rounded-md dark:bg-stone-100 dark:px-1.5" %>
          <% end %>
          <% if authenticated? %>
            <%= link_to t("nav.birthdays"), birthdays_path, class: "text-sm font-medium text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
          <% end %>
        </div>
        <% if authenticated? %>
          <div class="flex items-center gap-3">
            <%= link_to t("nav.settings"), settings_path, class: "text-sm font-medium text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-stone-100" %>
            <%= form_with url: session_path, method: :delete do %>
              <%= render ButtonComponent.new(type: :submit, variant: :ghost, size: :sm) do %>
                <%= t("nav.sign_out") %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>
    <% if notice.present? || alert.present? %>
      <div id="flash" class="pointer-events-none fixed inset-x-4 top-4 z-50 flex flex-col items-center gap-2 sm:inset-x-auto sm:right-4 sm:items-end">
        <%= render FlashComponent.new(kind: :notice, message: notice) if notice.present? %>
        <%= render FlashComponent.new(kind: :alert, message: alert) if alert.present? %>
      </div>
    <% end %>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <%= yield %>
    </main>
    <%= render layout: "modal", locals: { id: "discard-changes-dialog" } do %>
      <h2 class="text-lg font-semibold dark:text-stone-100"><%= t("discard_changes.title") %></h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= t("discard_changes.body") %></p>
      <div class="mt-4 flex justify-end gap-2">
        <button type="button" data-action="dialog#close" autofocus
                class="cursor-pointer rounded-lg px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700">
          <%= t("discard_changes.keep_editing") %>
        </button>
        <a id="discard-changes-confirm-link" href="#"
           class="cursor-pointer rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-500">
          <%= t("discard_changes.discard") %>
        </a>
      </div>
    <% end %>

    <%= render layout: "modal", locals: { id: "delete-entry-dialog" } do %>
      <h2 class="text-lg font-semibold dark:text-stone-100"><%= t("entries.delete_confirm_title") %></h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= t("entries.delete_confirm_body") %></p>
      <div class="mt-4 flex justify-end gap-2">
        <button type="button" data-action="dialog#close" autofocus
                class="cursor-pointer rounded-lg px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700">
          <%= t("entries.cancel") %>
        </button>
        <%= link_to t("entries.delete"), "#", id: "delete-entry-confirm-link",
              data: { turbo_method: :delete, action: "click->dialog#close" },
              class: "cursor-pointer rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-500" %>
      </div>
    <% end %>

    <%= render layout: "modal", locals: { id: "delete-friend-dialog" } do %>
      <h2 class="text-lg font-semibold dark:text-stone-100"><%= t("friends.delete_confirm_title") %></h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= t("friends.delete_confirm_body") %></p>
      <div class="mt-4 flex justify-end gap-2">
        <button type="button" data-action="dialog#close" autofocus
                class="cursor-pointer rounded-lg px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700">
          <%= t("friends.rename.cancel") %>
        </button>
        <%= link_to t("friends.show.delete"), "#", id: "delete-friend-confirm-link",
              data: { turbo_method: :delete, action: "click->dialog#close" },
              class: "cursor-pointer rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-500" %>
      </div>
    <% end %>
  </body>
</html>
