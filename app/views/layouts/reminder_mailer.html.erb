<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= message.subject %></title>
    <style>
      @media only screen and (max-width: 640px) {
        .email-shell { padding: 20px 10px !important; }
        .email-card-content { padding: 32px 24px !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f5f5f4; color: #29201d; font-family: 'Avenir Next', Avenir, 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent; mso-hide: all;">
      <%= content_for?(:preheader) ? yield(:preheader) : message.subject %>
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #f5f5f4;">
      <tr>
        <td class="email-shell" style="padding: 32px 16px; text-align: center;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 600px; margin: 0 auto;">
            <tr>
              <td style="padding: 0 8px 20px; text-align: left;">
                <%= image_tag @logo_url, alt: t("brand.logo_alt"), width: 160, height: 38,
                      style: "display: block; width: 160px; height: auto; border: 0;" %>
              </td>
            </tr>
            <tr>
              <td style="border: 1px solid #e7e5e4; border-radius: 20px; background-color: #fffdfb; box-shadow: 0 8px 24px rgba(41, 32, 29, 0.06); overflow: hidden;">
                <div style="height: 5px; background-color: #ef6a2e; font-size: 0; line-height: 0;">&nbsp;</div>
                <div class="email-card-content" style="padding: 44px 44px 40px;">
                  <%= yield %>
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding: 22px 24px 0; color: #78716c; font-size: 12px; line-height: 18px; text-align: center;">
                <%= t("reminder_mailer.footer") %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
