<% content_for :preheader, t(".preheader") %>

<p style="margin: 0 0 18px; color: #b45309; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;"><%= t(".eyebrow") %></p>

<h1 style="margin: 0; color: #29201d; font-size: 30px; line-height: 38px; font-weight: 700; letter-spacing: -0.6px;"><%= t(".heading") %></h1>

<p style="margin: 14px 0 0; color: #57534e; font-size: 16px; line-height: 26px;"><%= t(".body") %></p>

<div style="margin-top: 30px;">
  <%= render MailerButtonComponent.new(label: t(".cta"), url: @password_reset_url) %>
</div>

<p style="margin: 24px 0 0; color: #78716c; font-size: 13px; line-height: 20px;"><%= t(".expires", time: distance_of_time_in_words(0, @user.password_reset_token_expires_in)) %></p>
<p style="margin: 8px 0 0; color: #78716c; font-size: 13px; line-height: 20px;"><%= t(".ignore") %></p>

<div style="margin-top: 28px; padding-top: 22px; border-top: 1px solid #e7e5e4;">
  <p style="margin: 0; color: #78716c; font-size: 12px; line-height: 18px;"><%= t(".fallback") %></p>
  <p style="margin: 8px 0 0; overflow-wrap: anywhere; font-size: 12px; line-height: 18px;"><%= link_to @password_reset_url, @password_reset_url, style: "color: #a16207; text-decoration: underline;" %></p>
</div>
