<% content_for :title, t(".title") %>

<div class="mx-auto max-w-2xl">
  <%= render BackLinkComponent.new(fallback_path: root_path) %>
  <h1 class="mt-4 text-2xl font-bold"><%= t(".heading") %></h1>
  <p class="mt-2 text-stone-600 dark:text-stone-300"><%= t(".description") %></p>

  <%= render SectionComponent.new(class: "mt-6") do %>
    <%= form_with model: @vcard_import do |form| %>
      <%= render FileFieldComponent.new(
            form:,
            field: :file,
            label: t(".file_label"),
            hint: t(".file_hint", size: number_to_human_size(Rails.application.config.x.vcard_import_max_file_size_bytes)),
            choose_label: t(".choose_file"),
            empty_label: t(".no_file_selected"),
            accept: ".vcf,text/vcard,text/x-vcard") %>
      <p class="mt-4 text-sm text-stone-500 dark:text-stone-400"><%= t(".privacy") %></p>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= render ButtonComponent.new(type: :submit) do %>
          <%= t(".submit") %>
        <% end %>
        <%= link_to t(".cancel"), root_path,
              class: "rounded-lg px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700" %>
      </div>
    <% end %>
  <% end %>
</div>
