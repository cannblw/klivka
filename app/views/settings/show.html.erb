<% content_for :title, t(".title") %>

<%= render SettingsPageComponent.new(active: :account) do %>
  <div class="space-y-6">
    <%= render SectionComponent.new(title: t(".account"), description: t(".account_description")) do %>
      <div class="max-w-xl">
        <p class="text-sm font-medium text-stone-500 dark:text-stone-400"><%= t(".email") %></p>
        <p class="mt-1 text-sm"><%= @user.email_address %></p>
        <% unless demo_mode? %>
          <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
            <%= t(".password_note") %>
            <%= link_to t(".password_link"), new_password_path, class: "font-medium text-amber-600 hover:text-amber-500" %>.
          </p>
        <% end %>
      </div>
    <% end %>

    <%= render SectionComponent.new(title: t(".data_export"), description: t(".data_export_description")) do %>
      <div class="max-w-xl">
        <%= link_to account_export_path,
              class: "inline-flex items-center gap-2 text-sm font-medium text-amber-700 hover:text-amber-600 focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 dark:text-amber-400 dark:hover:text-amber-300" do %>
          <span class="material-icons" style="font-size: 18px" aria-hidden="true">download</span>
          <%= t(".download_data") %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
