<% content_for :title, t(".title") %>

<h1 class="text-2xl font-bold"><%= t(".heading") %></h1>

<%= form_with model: @user, url: settings_path, method: :patch,
      data: { controller: "settings-form theme" }, class: "mt-8 max-w-xl space-y-8" do |form| %>

  <div>
    <p class="text-sm font-medium text-stone-500 dark:text-stone-400"><%= t(".email") %></p>
    <p class="mt-1 text-sm"><%= @user.email_address %></p>
    <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
      <%= t(".password_note") %>
      <%= link_to t(".password_link"), new_password_path, class: "font-medium text-amber-600 hover:text-amber-500" %>.
    </p>
  </div>

  <fieldset>
    <legend class="text-sm font-medium text-stone-500 dark:text-stone-400"><%= t(".language") %></legend>
    <div class="mt-2 flex gap-2">
      <% [ :en, :es ].each do |locale| %>
        <label class="cursor-pointer select-none rounded-lg border px-4 py-2 text-sm font-medium transition
                      <%= @user.locale == locale.to_s ? "border-amber-600 bg-amber-50 text-amber-700 dark:border-amber-500 dark:bg-amber-900/30 dark:text-amber-400" : "border-stone-200 bg-stone-50 text-stone-600 hover:border-stone-300 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-300 dark:hover:border-stone-500" %>">
          <%= form.radio_button :locale, locale, checked: @user.locale == locale.to_s,
                data: { action: "change->settings-form#submit" }, class: "sr-only" %>
          <%= t(".locales.#{locale}") %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-medium text-stone-500 dark:text-stone-400"><%= t(".theme") %></legend>
    <div class="mt-2 flex gap-2">
      <% [ :light, :dark ].each do |theme| %>
        <label class="cursor-pointer select-none rounded-lg border px-4 py-2 text-sm font-medium transition
                      <%= @user.theme == theme.to_s ? "border-amber-600 bg-amber-50 text-amber-700 dark:border-amber-500 dark:bg-amber-900/30 dark:text-amber-400" : "border-stone-200 bg-stone-50 text-stone-600 hover:border-stone-300 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-300 dark:hover:border-stone-500" %>">
          <%= form.radio_button :theme, theme, checked: @user.theme == theme.to_s,
                data: { action: "change->theme#toggle change->settings-form#submit" }, class: "sr-only" %>
          <%= t(".themes.#{theme}") %>
        </label>
      <% end %>
    </div>
  </fieldset>

<% end %>
