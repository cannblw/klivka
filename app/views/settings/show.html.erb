<% content_for :title, t(".title") %>

<%= render SettingsPageComponent.new(active: :account) do %>
  <div class="space-y-6">
    <%= render SectionComponent.new(title: t(".account"), description: t(".account_description")) do %>
      <div class="max-w-xl">
        <p class="text-sm font-medium text-stone-500 dark:text-stone-400"><%= t(".email") %></p>
        <p class="mt-1 text-sm"><%= @user.email_address %></p>
        <% unless demo_mode? %>
          <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
            <%= t(".password_note") %>
            <%= link_to t(".password_link"), new_password_path, class: "font-medium text-amber-700 hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-300" %>.
          </p>
        <% end %>
      </div>
    <% end %>

    <%= render SectionComponent.new(title: t(".data_export"), description: t(".data_export_description")) do %>
      <div class="max-w-xl">
        <%= link_to account_export_path,
              class: "inline-flex items-center gap-2 text-sm font-medium text-amber-700 hover:text-amber-600 focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 dark:text-amber-400 dark:hover:text-amber-300" do %>
          <span class="material-icons" style="font-size: 18px" aria-hidden="true">download</span>
          <%= t(".download_data") %>
        <% end %>
      </div>
    <% end %>

    <% unless demo_mode? %>
      <%= render SectionComponent.new(title: t(".data_import"), description: t(".data_import_description")) do %>
        <%= form_with scope: :account_import, url: account_import_path, id: "account-import-form",
              data: {
                controller: "account-import",
                action: "change->account-import#fileChanged submit->account-import#import",
                turbo: false,
                account_import_preview_url_value: account_import_preview_path,
                account_import_retry_error_value: t(".data_import_retry_error")
              },
              class: "max-w-xl space-y-4" do |form| %>
          <%= render FileFieldComponent.new(
                form:,
                field: :file,
                label: t(".data_import_file_label"),
                hint: t(".data_import_file_hint", size: number_to_human_size(Rails.application.config.x.account_import_max_file_size_bytes)),
                choose_label: t(".data_import_choose_file"),
                empty_label: t(".data_import_no_file"),
                accept: ".json,application/json") %>

          <p class="text-sm text-stone-500 dark:text-stone-400"><%= t(".data_import_privacy") %></p>
          <p data-account-import-target="error" role="alert" hidden class="text-sm text-red-600 dark:text-red-400"></p>

          <%= render ButtonComponent.new(
                data: { action: "account-import#preview", account_import_target: "previewButton" }
              ) do %>
            <%= t(".data_import_preview") %>
          <% end %>

          <div data-account-import-target="review" hidden class="space-y-4">
            <div aria-live="polite" class="rounded-lg border border-stone-200 bg-stone-100 p-4 dark:border-stone-700 dark:bg-stone-900">
              <h3 class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t(".data_import_review_heading") %></h3>
              <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                <% %w[people archived_people entries interactions categories contact_methods reminders].each do |key| %>
                  <div>
                    <dt class="text-xs text-stone-500 dark:text-stone-400"><%= t(".data_import_summary.#{key}") %></dt>
                    <dd data-account-import-target="summary" data-summary-key="<%= key %>" class="text-sm font-medium">0</dd>
                  </div>
                <% end %>
              </dl>
            </div>

            <%= render InlineNoticeComponent.new do %>
              <%= t(".data_import_warning") %>
            <% end %>

            <%= render ButtonComponent.new(
                  disabled: true,
                  data: {
                    controller: "dialog-trigger",
                    action: "dialog-trigger#open",
                    dialog_trigger_dialog_id_value: "account-import-dialog",
                    account_import_target: "confirmButton"
                  }
                ) do %>
              <%= t(".data_import_continue") %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <%= render PasswordConfirmDialogComponent.new(
            id: "account-import-dialog",
            title: t(".data_import_confirm_title"),
            body: t(".data_import_confirm_body"),
            form_id: "account-import-form",
            password_name: "account_import[password]",
            password_label: t(".data_import_password_label"),
            password_hint: t(".data_import_password_hint"),
            confirm_label: t(".data_import_confirm"),
            cancel_label: t(".data_import_cancel")
          ) %>

      <%= render SectionComponent.new(title: t(".account_deletion"), description: t(".account_deletion_description")) do %>
        <div class="max-w-xl space-y-4">
          <p class="text-sm text-stone-600 dark:text-stone-300"><%= t(".account_deletion_warning") %></p>
          <p class="text-sm text-stone-600 dark:text-stone-300">
            <%= t(".account_deletion_export_prompt") %>
            <%= link_to t(".account_deletion_export"), account_export_path,
                  class: "font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
          </p>

          <%= form_with scope: :account, url: account_path, method: :delete, id: "account-deletion-form",
                data: { turbo: false } do %>
            <%= render ButtonComponent.new(
                  variant: :destructive,
                  data: {
                    controller: "dialog-trigger",
                    action: "dialog-trigger#open",
                    dialog_trigger_dialog_id_value: "account-deletion-dialog"
                  }
                ) do %>
              <%= t(".account_deletion_open") %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%= render PasswordConfirmDialogComponent.new(
            id: "account-deletion-dialog",
            title: t(".account_deletion_confirm_title"),
            body: t(".account_deletion_confirm_body"),
            form_id: "account-deletion-form",
            password_name: "account[password]",
            password_label: t(".account_deletion_password_label"),
            password_hint: t(".account_deletion_password_hint"),
            confirm_label: t(".account_deletion_confirm"),
            cancel_label: t(".account_deletion_cancel"),
            error: @account_deletion_error,
            open: @account_deletion_error.present?
          ) %>
    <% end %>
  </div>
<% end %>
