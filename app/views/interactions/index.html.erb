<% content_for :title, t("interactions.index.title", name: @person.name) %>

<%= link_to t("interactions.index.back", name: @person.name), @person,
      class: "text-sm text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-200" %>

<div class="mx-auto mt-6 max-w-2xl">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold"><%= t("interactions.index.heading", name: @person.name) %></h1>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t("interactions.index.description") %></p>
    </div>
    <% unless @person.archived? %>
      <%= link_to t("interactions.history.add"), new_person_interaction_path(@person),
            class: "rounded-lg bg-brand-action px-4 py-2 text-sm font-medium text-white hover:bg-brand-action-hover" %>
    <% end %>
  </div>

  <%= render InteractionHistoryComponent.new(
        person: @person,
        interactions: @interactions,
        total_count: @total_count,
        show_view_all: false,
        editable: !@person.archived?
      ) %>

  <% if @has_previous_page || @has_next_page %>
    <nav class="mt-6 flex items-center justify-between" aria-label="<%= t("interactions.pagination.label") %>">
      <% if @has_previous_page %>
        <%= link_to t("interactions.pagination.previous"), person_interactions_path(@person, page: @page - 1),
              class: "rounded-lg px-3 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700" %>
      <% else %>
        <span></span>
      <% end %>
      <span class="text-sm text-stone-500 dark:text-stone-400"><%= t("interactions.pagination.page", number: @page) %></span>
      <% if @has_next_page %>
        <%= link_to t("interactions.pagination.next"), person_interactions_path(@person, page: @page + 1),
              class: "rounded-lg px-3 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700" %>
      <% else %>
        <span></span>
      <% end %>
    </nav>
  <% end %>
</div>
