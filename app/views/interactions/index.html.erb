<% content_for :title, t("interactions.index.title", name: @friend.name) %>

<%= link_to t("interactions.index.back", name: @friend.name), @friend,
      class: "text-sm text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-200" %>

<div class="mx-auto mt-6 max-w-2xl">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold"><%= t("interactions.index.heading", name: @friend.name) %></h1>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t("interactions.index.description") %></p>
    </div>
    <%= link_to t("interactions.history.add"), new_friend_interaction_path(@friend),
          class: "rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-500" %>
  </div>

  <%= render InteractionHistoryComponent.new(
        friend: @friend,
        interactions: @interactions,
        total_count: @total_count,
        show_view_all: false
      ) %>

  <% if @has_previous_page || @has_next_page %>
    <nav class="mt-6 flex items-center justify-between" aria-label="<%= t("interactions.pagination.label") %>">
      <% if @has_previous_page %>
        <%= link_to t("interactions.pagination.previous"), friend_interactions_path(@friend, page: @page - 1),
              class: "rounded-lg px-3 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700" %>
      <% else %>
        <span></span>
      <% end %>
      <span class="text-sm text-stone-500 dark:text-stone-400"><%= t("interactions.pagination.page", number: @page) %></span>
      <% if @has_next_page %>
        <%= link_to t("interactions.pagination.next"), friend_interactions_path(@friend, page: @page + 1),
              class: "rounded-lg px-3 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700" %>
      <% else %>
        <span></span>
      <% end %>
    </nav>
  <% end %>
</div>
