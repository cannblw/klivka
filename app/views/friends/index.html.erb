<% content_for :title, t(".title") %>

<div data-controller="dialog" data-dialog-open-value="<%= @friend.errors.any? %>">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold"><%= t(".heading") %></h1>

    <%= render ButtonComponent.new(data: { action: "dialog#open" }) do %>
      <%= t(".add_friend") %>
    <% end %>
  </div>

  <dialog data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop"
          class="m-auto w-full max-w-sm rounded-xl p-0 shadow-xl backdrop:bg-stone-900/50 dark:bg-stone-800">
    <div class="p-6">
      <h2 class="text-lg font-semibold dark:text-stone-100"><%= t(".modal.heading") %></h2>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t(".modal.hint") %></p>

      <%= form_with model: @friend, class: "mt-4" do |form| %>
        <%= render InputFieldComponent.new(form, :name, type: :text,
              placeholder: t(".modal.name_placeholder"),
              autofocus: true,
              autocomplete: "off",
              class: "w-full") %>
        <div class="mt-4 flex justify-end gap-2">
          <%= render ButtonComponent.new(variant: :ghost, data: { action: "dialog#close" }) do %>
            <%= t(".modal.cancel") %>
          <% end %>
          <%= render ButtonComponent.new(type: :submit) do %>
            <%= t(".modal.submit") %>
          <% end %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>

<% if @friends.any? %>
  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(180px,1fr))] sm:gap-4">
    <%= render FriendCardComponent.with_collection(@friends) %>
  </div>
<% else %>
    <div class="mt-16 text-center text-stone-500 dark:text-stone-400">
    <p class="text-lg font-medium"><%= t(".empty.heading") %></p>
    <p class="mt-1 text-sm"><%= t(".empty.hint") %></p>
  </div>
<% end %>
