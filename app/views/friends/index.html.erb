<% content_for :title, t(".title") %>

<div data-controller="dialog" data-dialog-open-value="<%= @friend.errors.any? %>">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold"><%= t(".heading") %></h1>

    <%= render ButtonComponent.new(data: { action: "dialog#open" }) do %>
      <%= t(".add_friend") %>
    <% end %>
  </div>

  <dialog data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop"
          class="m-auto w-full max-w-sm rounded-xl p-0 shadow-xl backdrop:bg-gray-900/50">
    <div class="p-6">
      <h2 class="text-lg font-semibold"><%= t(".modal.heading") %></h2>
      <p class="mt-1 text-sm text-gray-500"><%= t(".modal.hint") %></p>

      <%= form_with model: @friend, class: "mt-4" do |form| %>
        <%= form.text_field :name,
              placeholder: t(".modal.name_placeholder"),
              autofocus: true,
              autocomplete: "off",
              class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        <% @friend.errors.full_messages_for(:name).each do |message| %>
          <p class="mt-1 text-sm text-red-600"><%= message %></p>
        <% end %>

        <div class="mt-4 flex justify-end gap-2">
          <%= render ButtonComponent.new(variant: :ghost, data: { action: "dialog#close" }) do %>
            <%= t(".modal.cancel") %>
          <% end %>
          <%= render ButtonComponent.new(type: :submit) { t(".modal.submit") } %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>

<% if @friends.any? %>
  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(180px,1fr))] sm:gap-4">
    <%= render FriendCardComponent.with_collection(@friends) %>
  </div>
<% else %>
  <div class="mt-16 text-center text-gray-500">
    <p class="text-lg font-medium"><%= t(".empty.heading") %></p>
    <p class="mt-1 text-sm"><%= t(".empty.hint") %></p>
  </div>
<% end %>
