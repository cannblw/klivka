<% content_for :title, @friend.name %>

<%= link_to t(".back"), root_path, class: "text-sm text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-200" %>

<% entries = @friend.entries.order(created_at: :desc).group_by(&:type) %>

<div data-controller="toggle" class="mt-4">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold"><%= @friend.name %></h1>

    <button type="button" data-action="toggle#toggle"
            class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-500 cursor-pointer">
      <%= t("entries.add") %>
    </button>
  </div>

  <div data-toggle-target="content" class="hidden mt-4">
    <div class="rounded-lg border border-stone-200 bg-stone-50 p-4 shadow-sm dark:border-stone-700 dark:bg-stone-800">
      <%= render "entries/form", entry: @new_entry, friend: @friend %>
    </div>
  </div>

  <% if entries.any? %>
    <div class="mt-6 space-y-6">
      <% entries.each do |type, group| %>
        <section>
          <h2 class="text-sm font-medium text-stone-500 dark:text-stone-400"><%= t("entries.kinds.#{type.demodulize.downcase}") %></h2>
          <div class="mt-2 space-y-2">
            <% group.each do |entry| %>
              <%= render "entries/card", entry: entry, friend: @friend %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div data-action="click->toggle#toggle" data-toggle-target="content"
         class="mt-12 cursor-pointer rounded-lg border-2 border-dashed border-stone-300 p-8 text-center transition hover:border-stone-400 dark:border-stone-600 dark:hover:border-stone-500">
      <p class="text-sm font-medium text-stone-600 dark:text-stone-300"><%= t("entries.empty_title") %></p>
      <p class="mt-1 text-sm text-stone-400 dark:text-stone-500"><%= t("entries.empty_hint") %></p>
    </div>
  <% end %>
</div>
