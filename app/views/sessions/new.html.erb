<% content_for :title, t(".title") %>

<%= render CardComponent.new do %>
  <h1 class="text-xl font-bold"><%= t(".heading") %></h1>

  <%= form_with url: session_url, class: "mt-4" do |form| %>
    <div class="space-y-3">
      <%= render InputFieldComponent.new(form, :email_address, type: :email,
            required: true, autofocus: true, autocomplete: "username",
            placeholder: t(".email_placeholder"), value: params[:email_address]) %>
      <%= render InputFieldComponent.new(form, :password, type: :password,
            required: true, autocomplete: "current-password", maxlength: 72,
            placeholder: t(".password_placeholder")) %>
    </div>

    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <%= render ButtonComponent.new(type: :submit) do %>
        <%= t(".submit") %>
      <% end %>
      <%= link_to t(".forgot_password"), new_password_path, class: "text-sm text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200" %>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
    <%= t(".no_account") %>
    <%= link_to t(".register"), signup_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
  </p>
<% end %>
