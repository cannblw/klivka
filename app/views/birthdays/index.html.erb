<% content_for :title, t(".title") %>

<h1 class="text-2xl font-bold"><%= t(".heading") %></h1>
<p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= l(Date.current, format: "%B") %></p>

<% if @birthdays.any? %>
  <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
    <%= render BirthdayCardComponent.with_collection(@birthdays) %>
  </div>
<% else %>
  <div class="mt-16 text-center text-stone-500 dark:text-stone-400">
    <p class="text-lg font-medium"><%= t(".empty_title") %></p>
    <p class="mt-1 text-sm"><%= t(".empty_hint") %></p>
  </div>
<% end %>
