<% content_for :title, t(".title") %>

<%= render BackLinkComponent.new(fallback_path: people_path) %>

<div class="mt-4">
  <h1 class="text-2xl font-bold"><%= t(".heading") %></h1>
  <p class="mt-1 max-w-xl text-sm text-stone-600 dark:text-stone-300"><%= t(".description") %></p>

  <% if @people.any? %>
    <%= render SectionComponent.new(class: "mt-6", aria: { label: t(".heading") }) do %>
      <ul class="divide-y divide-stone-200 dark:divide-stone-700">
        <% @people.each do |person| %>
          <li class="flex flex-col gap-3 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between">
            <%= link_to person.name, person_path(person), class: "min-w-0 break-words text-sm font-medium text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover" %>
            <div class="flex flex-wrap gap-2">
              <%= form_with url: restore_person_path(person), method: :patch do %>
                <%= render ButtonComponent.new(type: :submit, size: :sm) do %>
                  <%= t(".restore") %>
                <% end %>
              <% end %>
            <%= render ButtonComponent.new(
                  variant: :ghost,
                  size: :sm,
                  class: "text-red-600 hover:text-red-500 dark:text-red-400",
                  data: ConfirmDialogComponent.trigger_data(
                    url: person_path(person),
                    title: t("people.delete_confirm.title"),
                    body: t("people.delete_confirm.body"),
                    confirm_label: t("people.delete_confirm.confirm"),
                    cancel_label: t("people.delete_confirm.cancel"),
                    turbo_method: :delete
                  )
                ) do %>
                <%= t(".delete_permanently") %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <div class="mt-12 text-center text-stone-500 dark:text-stone-400" data-archived-people-empty>
      <p class="text-lg font-medium"><%= t(".empty.heading") %></p>
      <p class="mt-1 text-sm"><%= t(".empty.hint") %></p>
    </div>
  <% end %>
</div>
