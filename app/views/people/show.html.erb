<% content_for :title, @person.name %>

<%= link_to t(@back_translation_key || "people.show.back"), @back_path || root_path, class: "text-sm text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-200" %>

<% ordered_entries = @person.entries.includes(:entry_reminder).ordered.to_a %>

<% if @person.archived? %>
  <div class="mt-4 space-y-6">
    <%= render InlineNoticeComponent.new(data: { archived_person_notice: true }) do %>
      <p class="font-medium"><%= t(".archived_notice.heading") %></p>
      <p class="mt-1"><%= t(".archived_notice.body") %></p>
    <% end %>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <h1 class="min-w-0 break-words text-2xl font-bold"><%= @person.name %></h1>
      <div class="flex flex-wrap gap-2">
        <%= form_with url: restore_person_path(@person), method: :patch do %>
          <%= render ButtonComponent.new(type: :submit) do %>
            <%= t(".restore") %>
          <% end %>
        <% end %>
        <%= render ButtonComponent.new(
              variant: :ghost,
              class: "text-red-600 hover:text-red-500 dark:text-red-400",
              data: { controller: "delete-person", delete_person_url: person_path(@person), action: "click->delete-person#click" }
            ) do %>
          <%= t(".delete_permanently") %>
        <% end %>
      </div>
    </div>

    <%= render InteractionHistoryComponent.new(
          person: @person,
          interactions: @recent_interactions,
          total_count: @interaction_count,
          heading_key: "interactions.history.last_heading",
          editable: false
        ) %>

    <% if ordered_entries.any? %>
      <section aria-labelledby="archived-person-entries-heading">
        <h2 id="archived-person-entries-heading" class="text-lg font-semibold"><%= t(".saved_entries") %></h2>
        <div id="entries-feed" class="mt-3 space-y-4">
          <% ordered_entries.each do |entry| %>
            <%= render EntryCardComponent.new(entry: entry, person: @person, editable: false) %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
<div class="mt-4">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div data-controller="toggle" class="flex min-w-0 items-center gap-2">
      <h1 class="min-w-0 break-words text-2xl font-bold <%= "hidden" if @person.errors.any? %>" data-toggle-target="content"><%= @person.name %></h1>

      <div data-toggle-target="content" class="<%= "hidden" unless @person.errors.any? %>">
        <%= form_with model: @person, method: :patch, class: "flex max-w-full flex-wrap items-start gap-2" do |form| %>
          <% (@return_params || {}).each do |name, value| %>
            <%= hidden_field_tag name, value %>
          <% end %>
          <%= render InputFieldComponent.new(form, :name, type: :text, value: @person.name, class: "w-48 font-bold") %>
          <%= render ButtonComponent.new(type: :submit, size: :sm, class: "font-bold") do %>
            <%= t("people.rename.save") %>
          <% end %>
          <%= render ButtonComponent.new(variant: :ghost, size: :sm, data: { action: "toggle#toggle" }) do %>
            <%= t("people.rename.cancel") %>
          <% end %>
        <% end %>
      </div>

      <%= render ButtonComponent.new(
            variant: :ghost,
            size: :sm,
            class: "shrink-0 text-stone-400 dark:text-stone-500",
            data: { action: "toggle#toggle", toggle_target: "content" },
            aria: { label: t("people.rename.link") }
          ) do %>
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="m2.695 14.762-1.262 3.155a.5.5 0 0 0 .65.65l3.155-1.262a4 4 0 0 0 1.343-.886L17.5 5.501a2.121 2.121 0 0 0-3-3L3.58 13.419a4 4 0 0 0-.885 1.343Z"/>
        </svg>
      <% end %>
    </div>

    <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto sm:justify-end">
      <%= render QuickInteractionComponent.new(
            person: @person,
            interaction: @interaction_to_enrich,
            time_zone: Current.user.time_zone,
            open: @open_interaction_modal
          ) %>

      <%= link_to t("entries.add"), new_person_entry_path(@person),
            class: "rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-200 dark:border-stone-600 dark:text-stone-200 dark:hover:bg-stone-700" %>

      <div data-controller="dropdown" class="relative">
        <%= render ButtonComponent.new(
              variant: :ghost,
              size: :sm,
              class: "text-stone-400 dark:text-stone-500",
              data: { action: "dropdown#toggle" },
              aria: { label: t(".more_actions"), haspopup: "menu" }
            ) do %>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <circle cx="10" cy="4" r="1.5"/><circle cx="10" cy="10" r="1.5"/><circle cx="10" cy="16" r="1.5"/>
          </svg>
        <% end %>

        <div data-dropdown-target="menu" data-action="click->dropdown#close"
             class="absolute right-0 z-40 mt-1 hidden w-44 rounded-lg border border-stone-200 bg-stone-50 py-1 shadow-lg dark:border-stone-700 dark:bg-stone-800">
          <%= link_to t(".archive"), "#",
                data: { controller: "archive-person", archive_person_url: archive_person_path(@person), action: "click->archive-person#click" },
                class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-100 dark:text-stone-200 dark:hover:bg-stone-700" %>
          <%= link_to t(".delete_permanently"), "#",
                data: { controller: "delete-person", delete_person_url: person_path(@person), action: "click->delete-person#click" },
                class: "block px-4 py-2 text-sm text-red-600 hover:bg-stone-100 dark:text-red-400 dark:hover:bg-stone-700" %>
        </div>
      </div>
    </div>
  </div>

  <% if @last_interaction %>
    <% days = (Date.current - @last_interaction.occurred_on).to_i %>
    <p id="last-contacted" class="mt-1 text-sm text-stone-500 dark:text-stone-400">
      <%= t("interactions.last_contacted.label") %>:
      <% if days == 0 %>
        <%= t("interactions.last_contacted.today") %>
      <% else %>
        <%= t("interactions.last_contacted.ago", duration: distance_of_time_in_words(
          @last_interaction.occurred_on.in_time_zone,
          Date.current.in_time_zone,
          except: [:hours, :minutes, :seconds]
        )) %>
      <% end %>
    </p>
  <% else %>
    <p id="last-contacted" class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t("interactions.last_contacted.never") %></p>
  <% end %>

  <%= render PersonCategoryComponent.new(person: @person, categories: @categories) %>

  <%= render ContactReminderComponent.new(person: @person, reminder: @contact_reminder, class: "mt-6") %>

  <%= render PersonContactActionsComponent.new(entries: ordered_entries) %>

  <%= render InteractionHistoryComponent.new(
        person: @person,
        interactions: @recent_interactions,
        total_count: @interaction_count,
        heading_key: "interactions.history.last_heading"
      ) %>

  <%= render EntryTypePickerComponent.new(person: @person, types: EntryTypePickerComponent::COMMON_TYPES) %>

  <%= render PersonSuggestionsComponent.new(person: @person, entries: ordered_entries) %>

  <% if ordered_entries.any? %>
    <div id="entries-feed"
         data-controller="entry-sortable"
         data-entry-sortable-reorder-url-value="<%= reorder_person_entries_path(@person) %>"
         data-entry-sortable-error-message-value="<%= t("entries.reorder.invalid_order") %>"
         data-entry-sortable-moved-message-value="<%= t("entries.reorder.moved", position: "__POSITION__") %>">
      <div class="mt-8 space-y-4">
        <% ordered_entries.each do |entry| %>
          <%= render EntryCardComponent.new(entry: entry, person: @person) %>
        <% end %>
      </div>
      <p data-entry-sortable-target="status" class="sr-only" aria-live="polite"></p>
    </div>
  <% end %>
</div>
<% end %>
