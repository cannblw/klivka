<% content_for :title, t(".title") %>

<div data-controller="dialog people-creation-dialog"
     data-dialog-open-value="<%= @person.errors.any? || @batch_mode %>"
     data-dialog-clear-param-value="batch">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="text-2xl font-bold"><%= t(".heading") %></h1>

    <%= render PeopleCollectionActionsComponent.new(demo_mode: demo_mode?) %>
  </div>

  <%= render DialogComponent.new(
        id: "people-creation-dialog",
        labelledby: @batch_mode ? "batch-person-creation-heading" : "person-creation-heading",
        data: {
          dialog_target: "dialog",
          people_creation_dialog_target: "dialog",
          action: "click->dialog#closeOnBackdrop"
        }
      ) do %>
    <div class="p-6">
      <div data-people-creation-dialog-target="content" data-heading-id="person-creation-heading" class="<%= "hidden" if @batch_mode %>">
        <h2 id="person-creation-heading" class="text-lg font-semibold dark:text-stone-100"><%= t(".modal.heading") %></h2>
        <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t(".modal.hint") %></p>

        <%= form_with model: @person, class: "mt-4" do |form| %>
          <div class="space-y-2">
            <%= render InputFieldComponent.new(form, :name, type: :text,
                  placeholder: t(".modal.name_placeholder"),
                  autofocus: !@batch_mode,
                  autocomplete: "off",
                  data: { people_creation_dialog_target: "focus" },
                  class: "w-full") %>
            <%= render ButtonComponent.new(
                  variant: :ghost,
                  size: :sm,
                  class: "border border-stone-300 dark:border-stone-600",
                  data: { action: "people-creation-dialog#toggle" }
                ) do %>
              <%= t(".modal.add_multiple") %>
            <% end %>
          </div>
          <div class="mt-4 flex justify-end gap-2">
            <%= render ButtonComponent.new(variant: :ghost, data: { action: "dialog#close" }) do %>
              <%= t(".modal.cancel") %>
            <% end %>
            <%= render ButtonComponent.new(type: :submit) do %>
              <%= t(".modal.submit") %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div data-people-creation-dialog-target="content" data-heading-id="batch-person-creation-heading" class="<%= "hidden" unless @batch_mode %>">
        <h2 id="batch-person-creation-heading" class="text-lg font-semibold dark:text-stone-100"><%= t(".batch_modal.heading") %></h2>
        <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t(".batch_modal.hint") %></p>

        <%= form_with url: preview_batch_person_creation_path,
              scope: :batch_person_creation,
              class: "mt-4",
              data: { turbo: false } do |form| %>
          <div class="space-y-2">
            <div>
              <label for="batch-person-names" class="sr-only"><%= t(".batch_modal.names_label") %></label>
              <%= form.text_area :names,
                    value: @batch_creation.names,
                    id: "batch-person-names",
                    rows: 8,
                    autofocus: @batch_mode,
                    data: { people_creation_dialog_target: "focus" },
                    class: "block #{FormStyling::TEXTAREA_CLASSES}",
                    placeholder: t(".batch_modal.placeholder"),
                    aria: { describedby: ("batch-person-errors" if @batch_creation.errors.any?), invalid: @batch_creation.errors.any? } %>
              <% if @batch_creation.errors.any? %>
                <p id="batch-person-errors" class="mt-2 text-sm text-red-600 dark:text-red-400"><%= t(".batch_modal.names_required") %></p>
              <% end %>
            </div>
            <%= render ButtonComponent.new(
                  variant: :ghost,
                  size: :sm,
                  class: "border border-stone-300 dark:border-stone-600",
                  data: { action: "people-creation-dialog#toggle" }
                ) do %>
              <%= t(".batch_modal.add_one") %>
            <% end %>
          </div>
          <div class="mt-4 flex justify-end gap-2">
            <%= render ButtonComponent.new(variant: :ghost, data: { action: "dialog#close" }) do %>
              <%= t(".batch_modal.cancel") %>
            <% end %>
            <%= render ButtonComponent.new(type: :submit) do %>
              <%= t(".batch_modal.submit") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<%= turbo_frame_tag "people_grid" do %>
  <%= render PeopleQueryControlsComponent.new(
        search: @people_query,
        categories: @filter_categories,
        view: @view,
        grouping_available: @grouping_available
      ) %>

  <% if @people.any? %>
    <% if @grouped_view %>
      <div class="mt-6 space-y-6">
        <% @categorized_person_groups.each do |category, people| %>
          <section aria-labelledby="person-category-<%= category.id %>-heading">
            <h2 id="person-category-<%= category.id %>-heading" class="text-lg font-semibold"><%= category.name %></h2>
            <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-4">
              <%= render PersonCardComponent.with_collection(people) %>
            </div>
          </section>
        <% end %>

        <% if @uncategorized_people.any? %>
          <section aria-labelledby="uncategorized-people-heading">
            <h2 id="uncategorized-people-heading" class="text-lg font-semibold"><%= t(".uncategorized") %></h2>
            <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-4">
              <%= render PersonCardComponent.with_collection(@uncategorized_people) %>
            </div>
          </section>
        <% end %>
      </div>
    <% else %>
      <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-4">
        <%= render PersonCardComponent.with_collection(@people, show_category: true) %>
      </div>
    <% end %>
  <% elsif @people_query.filtered? %>
    <div class="mt-16 text-center text-stone-500 dark:text-stone-400" data-filtered-people-empty>
      <p class="text-lg font-medium"><%= t(".filters.no_results") %></p>
      <p class="mt-1 text-sm"><%= t(".filters.no_results_hint") %></p>
    </div>
  <% elsif @people_query.query.present? %>
    <div class="mt-16 text-center text-stone-500 dark:text-stone-400">
      <p class="text-lg font-medium"><%= t(".no_results", query: @people_query.query) %></p>
    </div>
  <% else %>
    <div class="mt-16 text-center text-stone-500 dark:text-stone-400">
      <p class="text-lg font-medium"><%= t(".empty.heading") %></p>
      <p class="mt-1 text-sm"><%= t(".empty.hint") %></p>
      <%= render PeopleCollectionActionsComponent.new(demo_mode: demo_mode?, class: "mt-4 justify-center") %>
    </div>
  <% end %>
<% end %>
</div>
