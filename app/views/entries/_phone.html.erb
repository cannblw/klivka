<% number = entry.content&.dig("number") %>
<% label = entry.content&.dig("label") %>

<% if number.present? %>
  <a href="tel:<%= number %>" class="text-sm font-medium text-amber-700 dark:text-amber-400">
    <%= number %>
  </a>
  <% if label.present? %>
    <span class="ml-2 rounded-full bg-stone-200 px-2 py-0.5 text-xs text-stone-600 dark:bg-stone-700 dark:text-stone-300"><%= label %></span>
  <% end %>
<% end %>
