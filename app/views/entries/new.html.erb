<% content_for :title, t("entries.new.title", name: @friend.name) %>

<%= link_to t("entries.new.back", name: @friend.name), @friend,
      class: "text-sm text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-200" %>

<div class="mx-auto mt-6 max-w-2xl">
  <% if @entry&.type.present? %>
    <h1 class="text-2xl font-bold"><%= t("entries.new.heading", type: t("entries.kinds.#{@entry.type.demodulize.underscore}"), name: @friend.name) %></h1>
    <div class="mt-4 rounded-lg border border-stone-200 bg-stone-50 p-4 shadow-sm dark:border-stone-700 dark:bg-stone-800">
      <%= render EntryFormComponent.new(entry: @entry, friend: @friend) %>
    </div>
  <% else %>
    <h1 class="text-2xl font-bold"><%= t("entries.type_picker.heading", name: @friend.name) %></h1>
    <% @entry&.errors&.full_messages_for(:type)&.each do |message| %>
      <p class="mt-3 text-sm text-red-600"><%= message %></p>
    <% end %>
    <%= render EntryTypePickerComponent.new(friend: @friend, searchable: true) %>
  <% end %>
</div>
