<% content_for :title, t(".title") %>

<%= render BackLinkComponent.new(fallback_path: root_path) %>

<h1 class="mt-4 text-2xl font-bold"><%= t(".heading") %></h1>
<p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t(".description") %></p>

<div class="mt-6 space-y-6">
  <%= render SectionComponent.new(title: t(".new.heading"), description: t(".new.description")) do %>
    <%= form_with model: @category.new_record? ? @category : (@new_category || Category.new), class: "flex max-w-xl flex-col gap-3 sm:flex-row sm:items-start" do |form| %>
      <div class="min-w-0 flex-1">
        <%= render InputFieldComponent.new(form, :name, type: :text,
              maxlength: Klivka::STRING_MAX_LENGTH,
              placeholder: t(".new.placeholder"),
              autocomplete: "off",
              class: "w-full") %>
      </div>
      <%= render ButtonComponent.new(type: :submit) do %>
        <%= t(".new.submit") %>
      <% end %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "category_organizer" do %>
    <% if @categories.any? %>
      <div class="space-y-4">
        <%= render CategoryManagementComponent.with_collection(@categories) %>
        <% if @uncategorized_people.any? %>
          <%= render SectionComponent.new(title: t(".uncategorized.heading")) do %>
            <p data-person-count="<%= @uncategorized_people.size %>" class="text-sm text-stone-500 dark:text-stone-400">
              <%= t("categories.person_count", count: @uncategorized_people.size) %>
            </p>
            <ul class="mt-3 divide-y divide-stone-200 dark:divide-stone-700">
              <% @uncategorized_people.each do |person| %>
                <li class="py-2">
                  <%= link_to person.name, person_path(person), data: { turbo_frame: "_top" }, class: "text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%= render SectionComponent.new do %>
        <div class="py-6 text-center">
          <p class="text-sm font-medium"><%= t(".empty.heading") %></p>
          <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t(".empty.description") %></p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
