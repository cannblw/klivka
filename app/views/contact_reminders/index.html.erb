<% content_for :title, t(".title") %>

<%= render BackLinkComponent.new(fallback_path: root_path) %>

<h1 class="mt-4 text-2xl font-bold"><%= t(".heading") %></h1>
<p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t(".description") %></p>

<div class="mt-6 space-y-6">
  <%= render SectionComponent.new(title: t(".default.heading"), description: t(".default.description")) do %>
    <p class="text-sm font-medium text-stone-700 dark:text-stone-200" data-contact-reminder-default="<%= Current.user.contact_reminders_enabled? ? "enabled" : "disabled" %>">
      <% if Current.user.contact_reminders_enabled? %>
        <%= t(".default.enabled", cadence: t("contact_reminder.cadences.#{Current.user.contact_reminder_cadence}")) %>
      <% else %>
        <%= t(".default.disabled") %>
      <% end %>
    </p>
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
      <%= link_to t(".default.due"), reminders_path, class: "text-sm font-medium text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover" %>
      <%= link_to t(".default.settings"), settings_reminders_path(anchor: "contact-reminders"), class: "text-sm font-medium text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover" %>
    </div>
  <% end %>

  <%= turbo_frame_tag "contact_reminder_organizer" do %>
    <%= render SectionComponent.new(title: t(".people.heading"), description: t(".people.description")) do %>
      <% if @people.any? %>
        <div data-controller="filter-list">
          <div class="max-w-xl">
            <%= render FilterSearchFieldComponent.new(
                  id: "contact-reminder-person-search",
                  label: t(".people.search_label"),
                  placeholder: t(".people.search_placeholder")
                ) %>
          </div>

          <ul class="mt-4 divide-y divide-stone-200 dark:divide-stone-700">
            <%= render ContactReminderOrganizerPersonComponent.with_collection(@people) %>
          </ul>

          <p class="mt-4 text-sm text-stone-500 dark:text-stone-400" data-filter-list-target="empty" hidden><%= t(".people.no_results") %></p>
        </div>
      <% else %>
        <p class="text-sm text-stone-500 dark:text-stone-400"><%= t(".people.empty") %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
