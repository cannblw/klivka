<% content_for :preheader, t(".body", name: @person.name, date: l(@occurrence_on, format: :long)) %>

<p style="margin: 0 0 18px; color: #b45309; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;"><%= t(".eyebrow") %></p>

<h1 style="margin: 0; color: #29201d; font-size: 30px; line-height: 38px; font-weight: 700; letter-spacing: -0.6px;"><%= t(".heading", name: @person.name) %></h1>

<p style="margin: 14px 0 0; color: #57534e; font-size: 16px; line-height: 26px;"><%= t(".body", name: @person.name, date: l(@occurrence_on, format: :long)) %></p>

<div style="margin: 28px 0 30px; padding: 18px 20px; border: 1px solid #fde68a; border-radius: 12px; background-color: #fffbeb;">
  <p style="margin: 0 0 4px; color: #a16207; font-size: 11px; line-height: 16px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;"><%= t(".date_label") %></p>
  <p style="margin: 0; color: #44403c; font-size: 17px; line-height: 24px; font-weight: 600;"><%= l(@occurrence_on, format: :long) %></p>
</div>

<%= render MailerButtonComponent.new(label: t(".open_person", name: @person.name), url: @person_url) %>

<div style="margin-top: 34px; padding-top: 22px; border-top: 1px solid #e7e5e4; font-size: 13px; line-height: 19px;"><%= link_to t(".settings"), @settings_url, style: "color: #78716c; text-decoration: underline;" %></div>
