<% content_for :preheader, t(".body", name: @person.name) %>

<p style="margin: 0 0 18px; color: #b45309; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;"><%= t(".eyebrow") %></p>

<h1 style="margin: 0; color: #29201d; font-size: 30px; line-height: 38px; font-weight: 700; letter-spacing: -0.6px;"><%= t(".heading", name: @person.name) %></h1>

<p style="margin: 14px 0 0; color: #57534e; font-size: 16px; line-height: 26px;"><%= t(".body", name: @person.name) %></p>

<div style="margin-top: 30px;"><%= render MailerButtonComponent.new(label: t(".record_contact"), url: @contact_url) %></div>

<p style="margin: 20px 0 0; font-size: 14px; line-height: 20px;"><%= link_to t(".open_person", name: @person.name), @person_url, style: "color: #a16207; font-weight: 600; text-decoration: underline; text-underline-offset: 3px;" %></p>

<div style="margin-top: 34px; padding-top: 22px; border-top: 1px solid #e7e5e4; font-size: 13px; line-height: 19px;"><%= link_to t(".settings"), @settings_url, style: "color: #78716c; text-decoration: underline;" %></div>
