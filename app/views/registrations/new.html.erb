<% content_for :title, t(".title") %>

<%= render CardComponent.new do %>
  <h1 class="text-xl font-bold"><%= t(".heading") %></h1>

  <%= form_with model: @user, url: signup_path, class: "mt-4" do |form| %>
    <div class="space-y-3">
      <%= render InputFieldComponent.new(form, :email_address, type: :email,
            required: true, autofocus: true, autocomplete: "username",
            placeholder: t(".email_placeholder")) %>
      <%= render InputFieldComponent.new(form, :password, type: :password,
            required: true, autocomplete: "new-password", maxlength: 72,
            placeholder: t(".password_placeholder")) %>
    </div>

    <div class="mt-4">
      <%= render ButtonComponent.new(type: :submit, class: "w-full") do %>
        <%= t(".submit") %>
      <% end %>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-gray-500">
    <%= t(".have_account") %>
    <%= link_to t(".sign_in"), new_session_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
  </p>
<% end %>
