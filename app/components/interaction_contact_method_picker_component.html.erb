<fieldset>
  <legend class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("interactions.follow_up.contact_method") %></legend>
  <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4" role="radiogroup">
    <% options.each do |option| %>
      <label class="cursor-pointer">
        <%= form.radio_button :contact_method_id, option.value,
              checked: selected_value.to_s == option.value.to_s,
              class: "peer sr-only" %>
        <span class="flex min-h-20 flex-col items-center justify-center gap-2 rounded-lg border border-stone-300 bg-stone-50 p-2 text-center text-xs font-medium text-stone-600 hover:border-brand-focus peer-checked:border-brand-focus peer-checked:bg-brand-surface peer-checked:text-brand-link peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-focus dark:border-stone-600 dark:bg-stone-800 dark:text-stone-300 dark:peer-checked:border-brand-on-dark dark:peer-checked:bg-brand-dark-surface/30 dark:peer-checked:text-brand-on-dark">
          <% if option.icon_library.present? %>
            <%= render ContactMethodIconComponent.new(
                  icon_library: option.icon_library,
                  icon_name: option.icon_name,
                  size: 24
                ) %>
          <% else %>
            <span class="material-icons leading-none" style="font-size: 24px" aria-hidden="true">block</span>
          <% end %>
          <span class="break-words"><%= option.name %></span>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
