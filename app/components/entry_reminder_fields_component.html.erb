<fieldset class="rounded-lg border border-stone-200 p-4 dark:border-stone-700">
  <legend class="px-1 text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("entries.reminder.heading") %></legend>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("entries.reminder.description") %></p>

  <%= form.fields_for :entry_reminder, reminder do |reminder_form| %>
    <label class="mt-4 flex cursor-pointer items-start gap-3">
      <%# Nested attributes remove the optional record through _destroy, so clearing this enable checkbox submits 1. %>
      <%= reminder_form.check_box :_destroy,
            { checked: reminder_enabled, class: "mt-0.5 size-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500 dark:border-stone-600" },
            "0", "1" %>
      <span class="text-sm font-medium"><%= t("entries.reminder.enabled") %></span>
    </label>

    <fieldset class="mt-4">
      <legend class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("entries.reminder.lead") %></legend>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div>
          <%= reminder_form.label :lead_value, t("entries.reminder.lead_value"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
          <%= render InputFieldComponent.new(reminder_form, :lead_value, type: :number, min: 0, max: FriendCrm::MAX_INT32, step: 1, class: "mt-1") %>
        </div>
        <div>
          <%= reminder_form.label :lead_unit, t("entries.reminder.lead_unit"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
          <%= render SelectFieldComponent.new(reminder_form, :lead_unit, choices: lead_unit_options, selected: reminder.lead_unit, wrapper_class: "mt-1") %>
          <% reminder.errors.full_messages_for(:lead_unit).each do |message| %>
            <p class="mt-1 text-sm text-red-600"><%= message %></p>
          <% end %>
        </div>
      </div>
    </fieldset>
  <% end %>
</fieldset>
