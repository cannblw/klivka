<fieldset class="rounded-lg border border-stone-200 p-4 dark:border-stone-700">
  <legend class="px-1 text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("entries.reminder.heading") %></legend>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("entries.reminder.description") %></p>

  <%= form.fields_for :entry_reminder, reminder do |reminder_form| %>
    <%# Nested attributes use _destroy for both omitting a new reminder and removing a persisted one. %>
    <%= reminder_form.hidden_field :_destroy,
          value: reminder_enabled ? "0" : "1",
          data: { reminder_date_target: "destroyField" } %>

    <div class="mt-4 <%= "hidden" if reminder_enabled %>" data-reminder-date-target="addButton">
      <%= render ButtonComponent.new(
            type: :button,
            size: :sm,
            data: { action: "reminder-date#enable" },
            aria: { controls: "entry-reminder-options", expanded: reminder_enabled }
          ) do %>
        <%= t("entries.reminder.add") %>
      <% end %>
    </div>

    <div id="entry-reminder-options"
         data-reminder-date-target="fields"
         class="mt-4 <%= "hidden" unless reminder_enabled %>">
      <div class="flex items-center <%= reminder.persisted? ? "justify-between" : "justify-end" %> gap-3">
        <% if reminder.persisted? %>
          <p class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-link dark:text-brand-on-dark"
             data-entry-reminder-status="on">
            <span class="material-icons" style="font-size:18px" aria-hidden="true">notifications</span>
            <%= t("entries.reminder.on") %>
          </p>
        <% end %>
        <%= render ButtonComponent.new(
              type: :button,
              variant: :ghost,
              size: :sm,
              class: "!text-red-600 hover:!bg-red-50 dark:!text-red-400 dark:hover:!bg-red-900/20",
              data: { action: "reminder-date#disable" },
              aria: { controls: "entry-reminder-options" }
            ) do %>
          <%= t("entries.reminder.remove") %>
        <% end %>
      </div>
      <p data-reminder-date-target="notice"
         aria-live="polite"
         class="mt-2 text-sm text-stone-600 dark:text-stone-300 <%= "hidden" unless leap_day_notice_visible? %>">
        <%= t("entries.reminder.leap_day_notice") %>
      </p>

      <fieldset class="mt-4">
        <legend class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("entries.reminder.recurrence.heading") %></legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          <% EntryReminder::RECURRENCES.each do |recurrence| %>
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-stone-200 p-3 dark:border-stone-700">
              <%= reminder_form.radio_button :recurrence, recurrence,
                    data: { reminder_date_target: "recurrence", action: "change->reminder-date#update" },
                    class: "mt-0.5 size-4 border-stone-300 text-brand-focus focus:ring-brand-focus dark:border-stone-600" %>
              <span>
                <span class="block text-sm font-medium"><%= t("entries.reminder.recurrence.#{recurrence}.label") %></span>
                <span class="mt-0.5 block text-sm text-stone-600 dark:text-stone-300"><%= t("entries.reminder.recurrence.#{recurrence}.hint") %></span>
              </span>
            </label>
          <% end %>
        </div>
        <% reminder.errors.full_messages_for(:recurrence).each do |message| %>
          <p class="mt-1 text-sm text-red-600"><%= message %></p>
        <% end %>
      </fieldset>

      <fieldset class="mt-4">
        <legend class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("entries.reminder.lead") %></legend>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div>
            <%= reminder_form.label :lead_value, t("entries.reminder.lead_value"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
            <%= render InputFieldComponent.new(reminder_form, :lead_value, type: :number, min: 0, max: Klivka::MAX_INT32, step: 1, class: "mt-1") %>
          </div>
          <div>
            <%= reminder_form.label :lead_unit, t("entries.reminder.lead_unit"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
            <%= render SelectFieldComponent.new(reminder_form, :lead_unit, choices: lead_unit_options, selected: reminder.lead_unit, wrapper_class: "mt-1") %>
            <% reminder.errors.full_messages_for(:lead_unit).each do |message| %>
              <p class="mt-1 text-sm text-red-600"><%= message %></p>
            <% end %>
          </div>
        </div>
      </fieldset>
    </div>
  <% end %>
</fieldset>
