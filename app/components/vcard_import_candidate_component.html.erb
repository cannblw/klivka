<li data-filter-list-target="item" data-search-value="<%= search_value %>"
    class="relative h-full rounded-xl border border-stone-200 bg-stone-50 p-4 transition focus-within:border-amber-500 focus-within:ring-1 focus-within:ring-amber-500 dark:border-stone-700 dark:bg-stone-800">
  <div class="flex items-start gap-3">
    <%= check_box_tag "vcard_import[selected_candidate_ids][]", candidate_id, selected,
          id: checkbox_id,
          aria: { describedby: details_id },
          data: { vcard_import_preview_target: "checkbox", action: "change->vcard-import-preview#updateCount" },
          class: "mt-1 size-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500 dark:border-stone-600 dark:bg-stone-700" %>
    <div class="min-w-0 flex-1">
      <span class="font-semibold text-stone-900 dark:text-stone-100"><%= name %></span>
      <div id="<%= details_id %>">
        <% if details.any? %>
          <ul class="mt-2 space-y-1 text-sm text-stone-600 dark:text-stone-300">
            <% details.each do |detail| %>
              <li class="break-words"><%= detail %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= t("vcard_imports.show.name_only") %></p>
        <% end %>
      </div>
    </div>
  </div>
  <label for="<%= checkbox_id %>" class="absolute inset-0 cursor-pointer rounded-xl hover:ring-1 hover:ring-amber-400 dark:hover:ring-amber-500">
    <span class="sr-only"><%= name %></span>
  </label>
</li>
