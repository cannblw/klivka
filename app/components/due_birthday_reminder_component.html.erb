<li class="py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <%= link_to person.name, helpers.person_path(person), class: "block truncate text-sm font-medium text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover" %>
      <p class="mt-0.5 text-sm text-stone-600 dark:text-stone-300"><%= t("reminders.birthday.occurs_on", date: l(occurrence_on, format: :long)) %></p>
      <p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400"><%= t("reminders.ready_since", date: l(reminder_on, format: :long)) %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to t("reminders.view_person"), helpers.person_path(person), class: "rounded-lg px-3 py-1.5 text-sm font-medium text-stone-600 hover:bg-stone-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-focus dark:text-stone-300 dark:hover:bg-stone-700" %>
      <%= link_to t("reminders.birthday.settings"), helpers.settings_reminders_path(anchor: "birthday-reminders"), class: "rounded-lg px-3 py-1.5 text-sm font-medium text-stone-600 hover:bg-stone-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-focus dark:text-stone-300 dark:hover:bg-stone-700" %>
    </div>
  </div>
</li>
