<section id="interactions-history" class="mt-8" aria-labelledby="interactions-history-heading">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <h2 id="interactions-history-heading" class="text-lg font-semibold text-stone-900 dark:text-stone-100">
      <%= t(heading_key) %>
    </h2>
    <div class="flex items-center gap-3">
      <% if editable? %>
        <%= link_to t("interactions.history.add"), new_person_interaction_path(person),
              class: "text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
      <% end %>
      <% if show_view_all? %>
        <%= link_to t("interactions.history.view_all", count: total_count), person_interactions_path(person),
              class: "text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
      <% end %>
    </div>
  </div>

  <% if interactions.empty? %>
    <p class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= t("interactions.history.empty") %></p>
  <% end %>

  <% if interactions.any? %>
    <ol class="mt-3 space-y-2">
      <% interactions.each do |interaction| %>
        <li class="rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-stone-700 dark:bg-stone-800">
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
            <time datetime="<%= interaction.occurred_on.iso8601 %>" class="text-sm font-medium">
              <%= l(interaction.occurred_on, format: :long) %>
            </time>
            <% if interaction.contact_method_name.present? %>
              <span class="inline-flex items-center gap-1 rounded-full bg-stone-200 px-2 py-0.5 text-xs text-stone-600 dark:bg-stone-700 dark:text-stone-300">
                <%= render ContactMethodIconComponent.new(
                      icon_library: interaction.contact_method_icon_library,
                      icon_name: interaction.contact_method_icon_name,
                      size: 12
                    ) %>
                <%= interaction.contact_method_name %>
              </span>
            <% end %>
          </div>
          <% if interaction.note.present? %>
            <p class="mt-1 whitespace-pre-wrap text-sm text-stone-600 dark:text-stone-300"><%= interaction.note %></p>
          <% end %>
          <% if editable? %>
            <div class="mt-2 flex gap-3 text-xs">
            <%= link_to t("interactions.history.edit"), edit_person_interaction_path(person, interaction),
                  class: "font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
            <%= link_to t("interactions.history.delete"), "#delete-interaction-dialog",
                  data: { controller: "delete-interaction", delete_interaction_url: person_interaction_path(person, interaction), action: "click->delete-interaction#click" },
                  class: "font-medium text-red-600 hover:text-red-500 dark:text-red-400 dark:hover:text-red-300" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>

<% if editable? %>
  <%= render ConfirmDialogComponent.new(
      id: "delete-interaction-dialog",
      title: t("interactions.delete_confirm.title"),
      body: t("interactions.delete_confirm.body"),
      confirm_label: t("interactions.history.delete"),
      cancel_label: t("interactions.delete_confirm.cancel"),
      confirm_link_id: "delete-interaction-confirm-link"
      ) %>
<% end %>
