<div class="flex items-start gap-2 rounded-lg bg-stone-100 px-3 py-2.5 text-sm text-stone-600 dark:bg-stone-800 dark:text-stone-300" data-birthday-reminder-status="<%= status_key %>">
  <span class="material-icons mt-0.5 shrink-0 text-amber-600 dark:text-amber-400" style="font-size:18px" aria-hidden="true">notifications</span>
  <p>
    <%= message %>
    <%= link_to t("birthday_reminder_status.#{settings_link_key}"), helpers.settings_reminders_path(anchor: "birthday-reminders"),
          data: { turbo_frame: "_top" },
          class: "font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
  </p>
</div>
