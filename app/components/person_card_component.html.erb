<%= link_to person, data: { turbo_frame: "_top" }, class: "flex min-w-0 flex-col items-center rounded-xl border border-stone-200 bg-stone-50 p-4 text-center shadow-sm transition hover:border-brand-border hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-focus dark:border-stone-700 dark:bg-stone-800 dark:hover:border-brand-on-dark dark:hover:shadow-lg dark:hover:shadow-stone-900/30" do %>
  <%= render PersonAvatarComponent.new(person:) %>

  <div class="mt-3 min-w-0 w-full">
    <p class="truncate font-medium text-stone-900 dark:text-stone-100"><%= person.name %></p>
    <% if show_category? %>
      <p class="mt-0.5 truncate text-xs text-stone-500 dark:text-stone-400"><%= person.category.name %></p>
    <% end %>
    <% if person.archived? %>
      <p class="mt-0.5 text-xs font-medium text-stone-500 dark:text-stone-400" data-archived-person><%= t("people.index.archived_status") %></p>
    <% end %>
  </div>
<% end %>
