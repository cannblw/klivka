<fieldset>
  <legend class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("contact_methods.icons.legend") %></legend>
  <div class="mt-2 grid grid-cols-5 gap-2 sm:grid-cols-8" role="radiogroup">
    <% icon_options.each do |library, name| %>
      <% value = option_value(library, name) %>
      <label title="<%= option_label(library, name) %>" class="cursor-pointer">
        <%= form.radio_button :icon, value,
              checked: selected.to_s == value,
              class: "peer sr-only" %>
        <span class="flex min-h-10 items-center justify-center rounded-lg border border-stone-300 bg-stone-50 px-2 text-stone-600 hover:border-brand-focus peer-checked:border-brand-focus peer-checked:bg-brand-surface peer-checked:text-brand-link peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-focus dark:border-stone-600 dark:bg-stone-800 dark:text-stone-300 dark:peer-checked:border-brand-on-dark dark:peer-checked:bg-brand-dark-surface/30 dark:peer-checked:text-brand-on-dark">
          <% if library %>
            <%= render ContactMethodIconComponent.new(icon_library: library, icon_name: name, size: 20) %>
          <% else %>
            <span class="material-icons leading-none" style="font-size: 20px" aria-hidden="true">block</span>
          <% end %>
          <span class="sr-only"><%= option_label(library, name) %></span>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
