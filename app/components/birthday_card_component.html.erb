<%= link_to friend, class: "flex items-center gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 shadow-sm transition hover:shadow-md dark:border-stone-700 dark:bg-stone-800 dark:hover:shadow-lg dark:hover:shadow-stone-900/30" do %>
  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-sm font-semibold text-amber-700 dark:bg-amber-800 dark:text-amber-200">
    <%= friend.initials %>
  </div>
  <div class="min-w-0">
    <p class="truncate font-medium"><%= friend.name %></p>
    <p class="text-sm text-stone-500 dark:text-stone-400">
      <%= l(birthday.entry_date, format: :long) %>
      <% if birthday.age %>
        (<%= birthday.age %> <%= t("entries.age") %>)
      <% end %>
    </p>
  </div>
<% end %>
