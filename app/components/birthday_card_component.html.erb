<%= link_to person_path, class: "flex items-center gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 shadow-sm transition hover:border-brand-border hover:bg-brand-surface hover:shadow-md focus-visible:border-brand-focus focus-visible:bg-brand-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-focus dark:border-stone-700 dark:bg-stone-800 dark:hover:border-brand-on-dark dark:hover:bg-brand-dark-surface/20 dark:hover:shadow-lg dark:hover:shadow-stone-900/30 dark:focus-visible:border-brand-on-dark dark:focus-visible:bg-brand-dark-surface/20" do %>
  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-surface-strong text-sm font-semibold text-brand-ink dark:bg-brand-dark-surface dark:text-brand-on-dark">
    <%= person.initials %>
  </div>
  <div class="min-w-0">
    <p class="truncate font-medium"><%= person.name %></p>
    <p class="text-sm text-stone-500 dark:text-stone-400">
      <%= l(occurrence_on, format: :long) %>
      <% if age %>
        (<%= age %> <%= t("entries.age") %>)
      <% end %>
    </p>
  </div>
<% end %>
