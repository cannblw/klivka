<%= render SectionComponent.new(aria: { labelledby: "category-#{category.id}-heading" }) do %>
  <div data-controller="toggle" class="space-y-3">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <div data-toggle-target="content" class="flex min-w-0 items-center gap-1.5 <%= "hidden" if category.errors.any? %>">
          <h2 id="category-<%= category.id %>-heading" class="min-w-0 break-words text-lg font-semibold"><%= category.name %></h2>
          <%= render ButtonComponent.new(
                variant: :ghost,
                size: :sm,
                class: "shrink-0 text-stone-400 dark:text-stone-500",
                data: { action: "toggle#toggle" },
                aria: { label: t("categories.actions.rename_category", name: category.name) }
              ) do %>
            <span class="material-icons" style="font-size: 16px" aria-hidden="true">edit</span>
          <% end %>
        </div>

        <div data-toggle-target="content" class="<%= "hidden" unless category.errors.any? %>">
          <%= form_with model: category, class: "flex max-w-xl flex-col gap-2 sm:flex-row sm:items-start" do |form| %>
            <div class="min-w-0 flex-1">
              <%= render InputFieldComponent.new(form, :name, type: :text, maxlength: FriendCrm::STRING_MAX_LENGTH, autocomplete: "off", class: "w-full") %>
            </div>
            <div class="flex gap-2">
              <%= render ButtonComponent.new(type: :submit, size: :sm) do %>
                <%= t("categories.actions.save") %>
              <% end %>
              <%= render ButtonComponent.new(variant: :ghost, size: :sm, data: { action: "toggle#toggle" }) do %>
                <%= t("categories.actions.cancel") %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <p data-person-count="<%= person_count %>" class="shrink-0 text-sm text-stone-500 dark:text-stone-400">
        <%= t("categories.person_count_parenthetical", count: person_count) %>
      </p>
    </div>

    <%= render CategoryPersonAutocompleteComponent.new(category: category) %>

    <% if category.people.any? %>
      <ul class="divide-y divide-stone-200 dark:divide-stone-700" aria-label="<%= t("categories.organizer.people_in", category: category.name) %>">
        <% category.people.sort_by { |person| [ PersonNameNormalizer.call(person.name), person.id ] }.each do |person| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <%= link_to person.name, person_path(person), data: { turbo_frame: "_top" }, class: "min-w-0 truncate text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
            <%= form_with url: person_category_assignment_path(person), method: :patch, scope: :category_assignment do |form| %>
              <%= form.hidden_field :category_id, value: "" %>
              <%= form.hidden_field :return_to, value: "categories" %>
              <%= render ButtonComponent.new(type: :submit, variant: :ghost, size: :sm) do %>
                <%= t("categories.organizer.remove") %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-stone-500 dark:text-stone-400"><%= t("categories.organizer.empty") %></p>
    <% end %>

    <div class="flex flex-wrap items-center gap-2">
      <%= render ButtonComponent.new(
            variant: :ghost,
            size: :sm,
            class: "text-red-600 hover:text-red-500 dark:text-red-400",
            data: {
              controller: "delete-category",
              action: "click->delete-category#click",
              delete_category_url: category_path(category),
              delete_category_message: t("categories.delete.body", count: person_count)
            }
          ) do %>
        <%= t("categories.actions.delete") %>
      <% end %>
    </div>
  </div>
<% end %>
