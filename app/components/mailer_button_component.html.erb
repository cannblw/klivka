<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%;">
  <tr>
    <td style="text-align: center;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
        <tr>
          <td style="border-radius: 9px; background-color: #d97706;">
            <%= link_to label, url,
                  style: "display: inline-block; padding: 12px 20px; border: 1px solid #d97706; border-radius: 9px; color: #ffffff; font-size: 14px; line-height: 20px; font-weight: 600; text-decoration: none;" %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
