<%= render DialogComponent.new(
      id: ConfirmDialogComponent::DOM_ID,
      labelledby: title_id,
      describedby: body_id,
      data: {
        controller: "confirm-dialog",
        action: "confirm-dialog:open@window->confirm-dialog#open close->confirm-dialog#restoreFocus click->confirm-dialog#closeOnBackdrop"
      }
    ) do %>
  <div class="p-6">
    <h2 id="<%= title_id %>" data-confirm-dialog-target="title" class="text-lg font-semibold dark:text-stone-100"></h2>
    <p id="<%= body_id %>" data-confirm-dialog-target="body" class="mt-2 text-sm text-stone-500 dark:text-stone-400"></p>
    <div class="mt-4 flex justify-end gap-2">
      <%= render ButtonComponent.new(
            variant: :ghost,
            autofocus: true,
            data: { action: "confirm-dialog#close", confirm_dialog_target: "cancel" }
          ) %>
      <%= form_with url: "#", method: :post,
            data: { turbo: true, confirm_dialog_target: "form", action: "turbo:submit-end->confirm-dialog#closeAfterSubmit" } do %>
        <%= hidden_field_tag "_method", "", disabled: true, data: { confirm_dialog_target: "method" } %>
        <%= render ButtonComponent.new(
              variant: :destructive,
              type: :submit,
              data: {
                action: "confirm-dialog#confirm",
                confirm_dialog_target: "confirm",
                destructive_classes: variant_classes(:destructive),
                primary_classes: variant_classes(:primary)
              }
            ) %>
      <% end %>
    </div>
  </div>
<% end %>
