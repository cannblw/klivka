<dialog id="<%= id %>" aria-labelledby="<%= title_id %>" aria-describedby="<%= body_id %>"
        data-controller="dialog" data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop"
        class="m-auto w-full max-w-sm rounded-xl p-0 shadow-xl backdrop:bg-stone-900/50 dark:bg-stone-800">
  <div class="p-6">
    <h2 id="<%= title_id %>" class="text-lg font-semibold dark:text-stone-100"><%= title %></h2>
    <p id="<%= body_id %>" class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= body %></p>
    <div class="mt-4 flex justify-end gap-2">
      <button type="button" data-action="dialog#close" autofocus
              class="cursor-pointer rounded-lg px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700">
        <%= cancel_label %>
      </button>
      <%= link_to confirm_label, "#", id: confirm_link_id, data: confirm_data, class: confirm_classes %>
    </div>
  </div>
</dialog>
