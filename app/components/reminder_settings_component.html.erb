<p class="max-w-xl text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.description") %></p>

<%= form_with model: user, url: helpers.settings_reminders_path, method: :patch, class: "mt-6 space-y-6" do |form| %>
  <%= render SectionComponent.new(title: t("settings.reminders.delivery_channels"), description: t("settings.reminders.delivery_channels_hint"), heading_id: "reminder-settings-heading", id: "reminder-channels") do %>
    <div class="max-w-xl space-y-3" data-reminder-settings-section="channels">
      <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-stone-200 p-3 dark:border-stone-700">
        <%= form.check_box :reminder_in_app_enabled, class: "mt-0.5 size-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500 dark:border-stone-600" %>
        <span>
          <span class="block text-sm font-medium"><%= t("settings.reminders.in_app") %></span>
          <span class="mt-0.5 block text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.in_app_hint") %></span>
        </span>
      </label>

      <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-stone-200 p-3 dark:border-stone-700">
        <%= form.check_box :reminder_email_enabled, class: "mt-0.5 size-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500 dark:border-stone-600" %>
        <span>
          <span class="block text-sm font-medium"><%= t("settings.reminders.email") %></span>
          <span class="mt-0.5 block text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.email_hint") %></span>
        </span>
      </label>

      <% unless delivery_channel_enabled? %>
        <%= render InlineNoticeComponent.new(data: { reminder_channels_notice: true }) do %>
          <%= t("settings.reminders.no_channels") %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render SectionComponent.new(title: t("settings.reminders.contacts.heading"), description: t("settings.reminders.contacts.description"), id: "contact-reminders") do %>
    <div class="max-w-xl space-y-4" data-reminder-settings-section="contacts" data-controller="contact-reminder-schedule">
      <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-stone-200 p-3 dark:border-stone-700">
        <%= form.check_box :contact_reminders_enabled, class: "mt-0.5 size-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500 dark:border-stone-600" %>
        <span>
          <span class="block text-sm font-medium"><%= t("settings.reminders.contacts.enabled") %></span>
          <span class="mt-0.5 block text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.contacts.enabled_hint") %></span>
        </span>
      </label>

      <%= render ContactReminderScheduleStatusComponent.new(first_reminder_on: user.contact_reminder_first_reminder_on) %>

      <div class="max-w-xs">
        <%= form.label :contact_reminder_cadence, t("settings.reminders.contacts.frequency"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
        <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.contacts.frequency_hint") %></p>
        <%= render SelectFieldComponent.new(form, :contact_reminder_cadence, choices: contact_cadence_options, selected: user.contact_reminder_cadence, wrapper_class: "mt-2", data: { contact_reminder_schedule_target: "cadence", action: "change->contact-reminder-schedule#change" }) %>
        <% user.errors.full_messages_for(:contact_reminder_cadence).each do |message| %>
          <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= message %></p>
        <% end %>
      </div>
      <%= render ContactReminderScheduleFieldsComponent.new(
            scope: "user",
            cadence: user.contact_reminder_cadence,
            first_reminder_on: user.contact_reminder_first_reminder_on,
            today: user.local_date,
            id_prefix: "account-contact-reminder"
          ) %>
    </div>
  <% end %>

  <%= render SectionComponent.new(title: t("settings.reminders.birthdays.heading"), description: t("settings.reminders.birthdays.description"), id: "birthday-reminders") do %>
    <div class="max-w-xl space-y-4" data-reminder-settings-section="birthdays">
      <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-stone-200 p-3 dark:border-stone-700">
        <%= form.check_box :birthday_reminders_enabled, class: "mt-0.5 size-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500 dark:border-stone-600" %>
        <span>
          <span class="block text-sm font-medium"><%= t("settings.reminders.birthdays.enabled") %></span>
          <span class="mt-0.5 block text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.birthdays.enabled_hint") %></span>
        </span>
      </label>

      <div>
        <p class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("settings.reminders.birthdays.timing") %></p>
        <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.birthdays.timing_hint") %></p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :birthday_reminder_lead_value, t("settings.reminders.lead_value"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
          <%= render InputFieldComponent.new(form, :birthday_reminder_lead_value, type: :number, min: 0, max: Klivka::MAX_INT32, step: 1) %>
        </div>
        <div>
          <%= form.label :birthday_reminder_lead_unit, t("settings.reminders.lead_unit"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
          <%= render SelectFieldComponent.new(form, :birthday_reminder_lead_unit, choices: lead_unit_options, selected: user.birthday_reminder_lead_unit) %>
          <% user.errors.full_messages_for(:birthday_reminder_lead_unit).each do |message| %>
            <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= message %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render SectionComponent.new(title: t("settings.reminders.other_dates.heading"), description: t("settings.reminders.other_dates.description"), id: "date-reminders") do %>
    <div class="max-w-xl" data-reminder-settings-section="other-dates">
      <p class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("settings.reminders.other_dates.timing") %></p>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("settings.reminders.other_dates.timing_hint") %></p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div>
          <%= form.label :default_reminder_lead_value, t("settings.reminders.lead_value"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
          <%= render InputFieldComponent.new(form, :default_reminder_lead_value, type: :number, min: 0, max: Klivka::MAX_INT32, step: 1, class: "mt-1") %>
        </div>
        <div>
          <%= form.label :default_reminder_lead_unit, t("settings.reminders.lead_unit"), class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
          <%= render SelectFieldComponent.new(form, :default_reminder_lead_unit, choices: lead_unit_options, selected: user.default_reminder_lead_unit, wrapper_class: "mt-1") %>
          <% user.errors.full_messages_for(:default_reminder_lead_unit).each do |message| %>
            <p class="mt-1 text-sm text-red-600 dark:text-red-400"><%= message %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render ButtonComponent.new(type: :submit) do %>
    <%= t("settings.reminders.save") %>
  <% end %>
<% end %>
