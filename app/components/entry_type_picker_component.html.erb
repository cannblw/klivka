<section class="mt-6" data-controller="<%= "entry-type-picker" if searchable? %>">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-sm font-medium text-stone-500 dark:text-stone-400">
      <%= t(searchable? ? "entries.type_picker.all_heading" : "entries.type_picker.common_heading") %>
    </h2>
    <% unless searchable? %>
      <%= link_to t("entries.type_picker.view_all"), new_friend_entry_path(friend_id: friend.id),
            class: "text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
    <% end %>
  </div>

  <% if searchable? %>
    <div class="mt-3">
      <%= label_tag "entry-type-search", t("entries.type_picker.search_label"), class: "sr-only" %>
      <%= search_field_tag nil, nil,
            id: "entry-type-search",
            placeholder: t("entries.type_picker.search_placeholder"),
            autocomplete: "off",
            data: { action: "input->entry-type-picker#filter" },
            class: "w-full rounded-lg border border-stone-300 bg-stone-50 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-100" %>
    </div>
  <% end %>

  <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
    <% displayed_types.each do |type| %>
      <li data-entry-type-picker-target="<%= "item" if searchable? %>"
          data-search-value="<%= label_for(type) if searchable? %>">
        <% if unavailable?(type) %>
          <div data-entry-type-unavailable class="flex h-full items-center gap-2 rounded-lg border border-stone-200 bg-stone-100 px-3 py-3 text-sm font-medium text-stone-400 dark:border-stone-700 dark:bg-stone-800/50 dark:text-stone-500">
            <span class="material-icons" style="font-size:18px" aria-hidden="true"><%= icon_for(type) %></span>
            <span><%= label_for(type) %></span>
            <span class="ml-auto text-xs font-normal"><%= t("entries.type_picker.already_added") %></span>
          </div>
        <% else %>
          <%= link_to new_friend_entry_path(friend_id: friend.id, type: type),
                class: "flex h-full items-center gap-2 rounded-lg border border-stone-200 bg-stone-50 px-3 py-3 text-sm font-medium text-stone-700 transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 dark:border-stone-700 dark:bg-stone-800 dark:text-stone-200 dark:hover:border-amber-700 dark:hover:bg-amber-900/20 dark:hover:text-amber-300" do %>
            <span class="material-icons text-stone-400" style="font-size:18px" aria-hidden="true"><%= icon_for(type) %></span>
            <span><%= label_for(type) %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if searchable? %>
    <p hidden data-entry-type-picker-target="empty" aria-live="polite" class="mt-6 text-center text-sm text-stone-500 dark:text-stone-400">
      <%= t("entries.type_picker.no_results") %>
    </p>
  <% end %>
</section>
