<section class="mt-8" data-controller="<%= "filter-list" if searchable? %>">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">
      <%= t(searchable? ? "entries.type_picker.all_heading" : "entries.type_picker.common_heading") %>
    </h2>
    <% unless searchable? %>
      <%= link_to t("entries.type_picker.view_all"), new_person_entry_path(person),
            class: "text-sm font-medium text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover" %>
    <% end %>
  </div>

  <% if searchable? %>
    <div class="mt-3">
      <%= render FilterSearchFieldComponent.new(
            id: "entry-type-search",
            label: t("entries.type_picker.search_label"),
            placeholder: t("entries.type_picker.search_placeholder")) %>
    </div>
  <% end %>

  <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-4">
    <% displayed_types.each do |type| %>
      <li data-filter-list-target="<%= "item" if searchable? %>"
          data-search-value="<%= label_for(type) if searchable? %>">
        <% if unavailable?(type) %>
          <div data-entry-type-unavailable class="flex h-full items-center gap-2 rounded-lg border border-stone-200 bg-stone-100 px-3 py-3 text-sm font-medium text-stone-400 dark:border-stone-700 dark:bg-stone-800/50 dark:text-stone-500">
            <span class="material-icons" style="font-size:18px" aria-hidden="true"><%= icon_for(type) %></span>
            <span><%= label_for(type) %></span>
            <span class="ml-auto text-xs font-normal"><%= t("entries.type_picker.already_added") %></span>
          </div>
        <% else %>
          <%= link_to new_person_entry_path(person, type: type),
                class: "flex h-full items-center gap-2 rounded-lg border border-stone-200 bg-stone-50 px-3 py-3 text-sm font-medium text-stone-700 transition hover:border-brand-border hover:bg-brand-surface hover:text-brand-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-focus dark:border-stone-700 dark:bg-stone-800 dark:text-stone-200 dark:hover:border-brand-on-dark dark:hover:bg-brand-dark-surface/20 dark:hover:text-brand-on-dark-hover" do %>
            <span class="material-icons text-stone-400" style="font-size:18px" aria-hidden="true"><%= icon_for(type) %></span>
            <span><%= label_for(type) %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if searchable? %>
    <p hidden data-filter-list-target="empty" aria-live="polite" class="mt-6 text-center text-sm text-stone-500 dark:text-stone-400">
      <%= t("entries.type_picker.no_results") %>
    </p>
  <% end %>
</section>
