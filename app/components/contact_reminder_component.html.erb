<section id="contact-reminder" class="mt-6 rounded-lg border border-stone-200 bg-stone-50 p-4 dark:border-stone-700 dark:bg-stone-800" aria-labelledby="contact-reminder-heading">
  <h2 id="contact-reminder-heading" class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("contact_reminder.heading") %></h2>

  <% if enabled? %>
    <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t("contact_reminder.current_frequency", frequency: cadence_label) %></p>
    <% if due? %>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("contact_reminder.due", name: friend.name) %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button"
                data-controller="open-quick-interaction"
                data-action="open-quick-interaction#open"
                aria-controls="<%= QuickInteractionComponent::DOM_ID %>"
                aria-haspopup="dialog"
                class="cursor-pointer rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-500">
          <%= t("contact_reminder.contacted_today") %>
        </button>

        <%= form_with url: snooze_friend_keep_in_touch_setting_path(friend), method: :patch, scope: :keep_in_touch_setting do |form| %>
          <%= form.hidden_field :lock_version, value: setting.lock_version %>
          <%= render ButtonComponent.new(variant: :ghost, type: :submit) do %>
            <%= t("contact_reminder.snooze") %>
          <% end %>
        <% end %>
      </div>
    <% elsif snoozed? %>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("contact_reminder.snoozed_until", date: l(next_suggestion_on, format: :long)) %></p>
    <% else %>
      <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("contact_reminder.next_suggestion", date: l(next_suggestion_on, format: :long)) %></p>
    <% end %>

    <details class="mt-4 border-t border-stone-200 pt-4 dark:border-stone-700">
      <summary class="cursor-pointer text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300"><%= t("contact_reminder.change_frequency") %></summary>
      <%= form_with url: friend_keep_in_touch_setting_path(friend), method: :patch, scope: :keep_in_touch_setting, class: "mt-3 flex flex-wrap items-end gap-2" do |form| %>
        <div class="w-full sm:w-auto">
          <%= form.label :cadence, t("contact_reminder.frequency"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
          <%= render SelectFieldComponent.new(form, :cadence, choices: cadence_options, selected: selected_cadence, class: "mt-1") %>
        </div>
        <%= form.hidden_field :lock_version, value: setting.lock_version %>
        <%= render ButtonComponent.new(type: :submit) do %>
          <%= t("contact_reminder.save_frequency") %>
        <% end %>
      <% end %>
    </details>

    <%= form_with url: disable_friend_keep_in_touch_setting_path(friend), method: :patch, scope: :keep_in_touch_setting, class: "mt-3" do |form| %>
      <%= form.hidden_field :lock_version, value: setting.lock_version %>
      <%= render ButtonComponent.new(variant: :ghost, type: :submit, class: "text-stone-600 dark:text-stone-300") do %>
        <%= t("contact_reminder.turn_off") %>
      <% end %>
    <% end %>
  <% else %>
    <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t(setting ? "contact_reminder.off" : "contact_reminder.description") %></p>

    <%= form_with url: activation_form_action, method: activation_form_method, scope: :keep_in_touch_setting, class: "mt-3 flex flex-wrap items-end gap-2" do |form| %>
      <div class="w-full sm:w-auto">
        <%= form.label :cadence, t("contact_reminder.frequency"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
        <%= render SelectFieldComponent.new(form, :cadence, choices: cadence_options, selected: selected_cadence, class: "mt-1") %>
      </div>
      <% if setting %>
        <%= form.hidden_field :lock_version, value: setting.lock_version %>
      <% end %>
      <%= render ButtonComponent.new(type: :submit) do %>
        <%= t("contact_reminder.turn_on") %>
      <% end %>
    <% end %>
  <% end %>
</section>
