<section id="contact-reminder" class="<%= classes %>" aria-labelledby="contact-reminder-heading" <%= tag.attributes(options) %>>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <h2 id="contact-reminder-heading" class="text-base font-semibold text-stone-900 dark:text-stone-100"><%= t("contact_reminder.heading") %></h2>
      <% if enabled? %>
        <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t("contact_reminder.current_frequency", frequency: cadence_label) %></p>
        <% if inherited? %>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t("contact_reminder.using_account_setting_html", settings_link: link_to(t("contact_reminder.settings"), helpers.settings_path, class: "text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300")) %></p>
        <% end %>
      <% end %>
    </div>

    <% if enabled? && !due? %>
      <div class="inline-flex max-w-full items-center gap-2 self-start rounded-lg bg-stone-100 px-3 py-2 text-sm font-medium text-stone-700 dark:bg-stone-700 dark:text-stone-200">
        <span class="material-icons shrink-0 text-stone-400 dark:text-stone-500" style="font-size:18px" aria-hidden="true">event</span>
        <span><%= snoozed? ? t("contact_reminder.snoozed_until", date: l(next_suggestion_on, format: :long)) : t("contact_reminder.next_suggestion", date: l(next_suggestion_on, format: :long)) %></span>
      </div>
    <% end %>
  </div>

  <% if enabled? %>
    <% if due? %>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-stone-600 dark:text-stone-300"><%= t("contact_reminder.due", name: person.name) %></p>
        <div class="flex flex-wrap gap-2">
          <%= render ButtonComponent.new(
                data: { controller: "open-quick-interaction", action: "open-quick-interaction#open" },
                aria: { controls: QuickInteractionComponent::DOM_ID, haspopup: "dialog" }
              ) do %>
            <%= t("contact_reminder.contacted_today") %>
          <% end %>

          <%= form_with url: snooze_person_keep_in_touch_setting_path(person), method: :patch, scope: :keep_in_touch_setting do |form| %>
            <%= render ButtonComponent.new(variant: :ghost, type: :submit) do %>
              <%= t("contact_reminder.snooze") %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="mt-4 flex flex-col gap-2 border-t border-stone-200 pt-3 sm:flex-row sm:items-start sm:justify-between dark:border-stone-700">
      <details class="min-w-0">
        <summary class="cursor-pointer py-1.5 text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300"><%= t("contact_reminder.change_frequency") %></summary>
        <%= form_with url: person_keep_in_touch_setting_path(person), method: frequency_form_method, scope: :keep_in_touch_setting, class: "mt-3 flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
          <div class="w-full sm:w-56">
            <%= form.label :cadence, t("contact_reminder.frequency"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
            <%= render SelectFieldComponent.new(form, :cadence, choices: cadence_options, selected: selected_cadence, wrapper_class: "mt-1") %>
          </div>
          <%= render ButtonComponent.new(type: :submit) do %>
            <%= t("contact_reminder.save_frequency") %>
          <% end %>
        <% end %>
      </details>

      <%= form_with url: disable_person_keep_in_touch_setting_path(person), method: :patch, scope: :keep_in_touch_setting do |form| %>
        <%= render ButtonComponent.new(variant: :ghost, size: :sm, type: :submit) do %>
          <%= t("contact_reminder.turn_off") %>
        <% end %>
      <% end %>

      <% if setting %>
        <%= form_with url: person_keep_in_touch_setting_path(person), method: :delete, scope: :keep_in_touch_setting do |form| %>
          <%= render ButtonComponent.new(variant: :ghost, size: :sm, type: :submit, title: t("contact_reminder.use_default_setting_hint")) do %>
            <%= t("contact_reminder.use_default_setting") %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-2 text-sm text-stone-600 dark:text-stone-300"><%= t(opted_out? ? "contact_reminder.off_for_person" : "contact_reminder.description") %></p>

    <%= form_with url: activation_form_action, method: activation_form_method, scope: :keep_in_touch_setting, class: "mt-4 flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
      <div class="w-full sm:w-56">
        <%= form.label :cadence, t("contact_reminder.frequency"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
        <%= render SelectFieldComponent.new(form, :cadence, choices: cadence_options, selected: selected_cadence, wrapper_class: "mt-1") %>
      </div>
      <% if setting %>
      <% end %>
      <%= render ButtonComponent.new(type: :submit) do %>
        <%= t("contact_reminder.turn_on") %>
      <% end %>
    <% end %>

    <% if opted_out? %>
      <%= form_with url: person_keep_in_touch_setting_path(person), method: :delete, scope: :keep_in_touch_setting, class: "mt-3" do |form| %>
        <%= render ButtonComponent.new(variant: :ghost, size: :sm, type: :submit, title: t("contact_reminder.use_default_setting_hint")) do %>
          <%= t("contact_reminder.use_default_setting") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
