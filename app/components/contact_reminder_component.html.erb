<section id="contact-reminder" class="<%= classes %>" aria-labelledby="contact-reminder-heading" <%= tag.attributes(options) %>>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <h2 id="contact-reminder-heading" class="text-sm font-medium text-stone-700 dark:text-stone-200"><%= t("contact_reminder.heading") %></h2>
      <% if enabled? %>
        <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t("contact_reminder.current_frequency", frequency: cadence_label) %></p>
        <% if inherited? %>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t("contact_reminder.using_account_setting_html", settings_link: link_to(t("contact_reminder.settings"), helpers.settings_reminders_path(anchor: "contact-reminders"), class: "text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover")) %></p>
        <% end %>
      <% else %>
        <p class="mt-1 text-sm text-stone-600 dark:text-stone-300"><%= t(opted_out? ? "contact_reminder.off_for_person" : "contact_reminder.not_set") %></p>
        <% if opted_out? && account_reminder_enabled? %>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t("contact_reminder.account_default", frequency: account_cadence_label) %></p>
        <% end %>
      <% end %>
    </div>

    <% if enabled? && !due? %>
      <div class="inline-flex max-w-full items-center gap-2 self-start rounded-lg bg-stone-100 px-3 py-2 text-sm font-medium text-stone-700 dark:bg-stone-700 dark:text-stone-200">
        <span class="material-icons shrink-0 text-stone-400 dark:text-stone-500" style="font-size:18px" aria-hidden="true">event</span>
        <span><%= snoozed? ? t("contact_reminder.snoozed_until", date: l(next_suggestion_on, format: :long)) : t("contact_reminder.next_reminder", date: l(next_suggestion_on, format: :long)) %></span>
      </div>
    <% end %>
  </div>

  <% if enabled? && due? %>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-stone-600 dark:text-stone-300"><%= t("contact_reminder.due", name: person.name) %></p>
      <div class="flex flex-wrap gap-2">
        <%= render ButtonComponent.new(
              data: { controller: "open-quick-interaction", action: "open-quick-interaction#open" },
              aria: { controls: QuickInteractionComponent::DOM_ID, haspopup: "dialog" }
            ) do %>
          <%= t("contact_reminder.contacted_today") %>
        <% end %>

        <%= form_with url: snooze_person_keep_in_touch_setting_path(person), method: :patch, scope: :keep_in_touch_setting do |form| %>
          <%= render ButtonComponent.new(variant: :ghost, type: :submit) do %>
            <%= t("contact_reminder.snooze") %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if enabled? || (opted_out? && account_reminder_enabled?) %>
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <% if enabled? %>
        <%= form_with url: disable_person_keep_in_touch_setting_path(person), method: :patch, scope: :keep_in_touch_setting do |form| %>
          <%= render ButtonComponent.new(variant: :ghost, size: :sm, type: :submit) do %>
            <%= t("contact_reminder.turn_off") %>
          <% end %>
        <% end %>
      <% end %>

      <% if opted_out? && account_reminder_enabled? %>
        <%= form_with url: person_keep_in_touch_setting_path(person), method: :delete, scope: :keep_in_touch_setting do |form| %>
          <button type="submit" class="cursor-pointer text-sm font-medium text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover">
            <%= use_default_label %>
          </button>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <details class="mt-3" data-contact-reminder-settings>
    <summary class="inline-flex cursor-pointer items-center gap-1 py-1.5 text-sm font-medium text-brand-link hover:text-brand-link-hover dark:text-brand-on-dark dark:hover:text-brand-on-dark-hover"><%= settings_summary %></summary>
    <div class="mt-3 max-w-xl space-y-3">
      <% if enabled? %>
        <%= form_with url: person_keep_in_touch_setting_path(person), method: frequency_form_method, scope: :keep_in_touch_setting, class: "space-y-3", data: { controller: "contact-reminder-schedule" } do |form| %>
          <%= render ContactReminderScheduleStatusComponent.new(first_reminder_on: reminder.first_reminder_on) %>
          <div class="w-full sm:w-56">
            <%= form.label :cadence, t("contact_reminder.frequency"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
            <%= render SelectFieldComponent.new(form, :cadence, choices: cadence_options, selected: selected_cadence, wrapper_class: "mt-1", data: { contact_reminder_schedule_target: "cadence", action: "change->contact-reminder-schedule#change" }) %>
          </div>
          <%= render ContactReminderScheduleFieldsComponent.new(scope: "keep_in_touch_setting", cadence: selected_cadence, first_reminder_on: reminder.first_reminder_on, today: person.user.local_date, id_prefix: "person-contact-reminder-change") %>
          <%= render ButtonComponent.new(type: :submit) do %>
            <%= t("contact_reminder.save_frequency") %>
          <% end %>
        <% end %>

        <% if setting %>
          <div class="border-t border-stone-200 pt-3 dark:border-stone-700">
            <%= form_with url: person_keep_in_touch_setting_path(person), method: :delete, scope: :keep_in_touch_setting do |form| %>
              <%= render ButtonComponent.new(variant: :ghost, size: :sm, type: :submit, title: t("contact_reminder.use_default_setting_hint")) do %>
                <%= account_reminder_enabled? ? use_default_label : t("contact_reminder.use_default_reminder") %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-stone-600 dark:text-stone-300"><%= t("contact_reminder.description") %></p>
        <%= form_with url: activation_form_action, method: activation_form_method, scope: :keep_in_touch_setting, class: "space-y-3", data: { controller: "contact-reminder-schedule" } do |form| %>
          <%= render ContactReminderScheduleStatusComponent.new(first_reminder_on: setting&.first_reminder_on) %>
          <div class="w-full sm:w-56">
            <%= form.label :cadence, t("contact_reminder.frequency"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
            <%= render SelectFieldComponent.new(form, :cadence, choices: cadence_options, selected: selected_cadence, wrapper_class: "mt-1", data: { contact_reminder_schedule_target: "cadence", action: "change->contact-reminder-schedule#change" }) %>
          </div>
          <%= render ContactReminderScheduleFieldsComponent.new(scope: "keep_in_touch_setting", cadence: selected_cadence, first_reminder_on: setting&.first_reminder_on, today: person.user.local_date, id_prefix: "person-contact-reminder-enable") %>
          <%= render ButtonComponent.new(type: :submit) do %>
            <%= t("contact_reminder.turn_on") %>
          <% end %>
        <% end %>

      <% end %>
    </div>
  </details>
</section>
