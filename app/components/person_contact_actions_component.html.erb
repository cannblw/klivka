<%= helpers.turbo_frame_tag PersonContactActionsComponent::DOM_ID do %>
  <% if contact_entries.any? %>
    <div class="mt-8" data-controller="dialog">
      <h2 id="contact-actions-heading" class="text-lg font-semibold text-stone-900 dark:text-stone-100"><%= t("contact_actions.heading") %></h2>
      <div role="group" class="mt-3 flex flex-wrap gap-2" aria-labelledby="contact-actions-heading">
        <% [ :phone, :email ].each do |kind| %>
          <% initial_entries_for(kind).each do |entry| %>
            <%= link_to href_for(entry),
                  class: "inline-flex max-w-full items-center gap-1.5 rounded-lg bg-brand-surface px-3 py-2 text-sm font-medium text-brand-link hover:bg-brand-surface-strong dark:bg-brand-dark-surface/30 dark:text-brand-on-dark dark:hover:bg-brand-dark-surface/50",
                  aria: { label: action_label_for(entry) } do %>
              <span class="material-icons" style="font-size:18px" aria-hidden="true"><%= action_icon_for(entry) %></span>
              <span class="min-w-0">
                <% if label_for(entry).present? %>
                  <span class="block text-xs font-normal"><%= label_for(entry) %></span>
                <% end %>
                <span class="block break-all"><%= value_for(entry) %></span>
              </span>
            <% end %>
          <% end %>
        <% end %>

        <% if overflow? %>
          <button type="button" data-action="dialog#open"
                  class="cursor-pointer rounded-lg px-3 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700">
            <%= t("contact_actions.view_all", count: contact_entries.size) %>
          </button>
        <% end %>
      </div>

      <% if overflow? %>
        <%= render DialogComponent.new(
              labelledby: "contact-methods-title",
              size: :lg,
              data: { dialog_target: "dialog", action: "click->dialog#closeOnBackdrop" }
            ) do %>
        <div class="p-6">
          <div class="flex items-center justify-between gap-4">
            <h2 id="contact-methods-title" class="text-lg font-semibold dark:text-stone-100"><%= t("contact_actions.title") %></h2>
            <button type="button" data-action="dialog#close" class="cursor-pointer rounded-lg px-3 py-1.5 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700">
              <%= t("contact_actions.close") %>
            </button>
          </div>

          <div class="mt-4 max-h-[70vh] space-y-5 overflow-y-auto pr-1">
            <% [ :phone, :email ].each do |kind| %>
              <% kind_entries = entries_for(kind) %>
              <% if kind_entries.any? %>
                <section>
                  <h3 class="text-sm font-medium text-stone-500 dark:text-stone-400"><%= t("entries.kinds.#{kind}") %></h3>
                  <ul class="mt-2 space-y-2">
                    <% kind_entries.each do |entry| %>
                      <li class="flex min-w-0 items-center justify-between gap-3 rounded-lg border border-stone-200 bg-stone-50 p-3 dark:border-stone-700 dark:bg-stone-800">
                        <div class="min-w-0">
                          <%= link_to value_for(entry), href_for(entry), class: "block truncate text-sm font-medium text-brand-link dark:text-brand-on-dark", aria: { label: action_label_for(entry) } %>
                          <% if label_for(entry).present? %>
                            <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= label_for(entry) %></p>
                          <% end %>
                        </div>
                        <button type="button"
                                data-controller="clipboard"
                                data-clipboard-text-value="<%= value_for(entry) %>"
                                data-action="click->clipboard#copy"
                                class="inline-flex size-6 shrink-0 cursor-pointer items-center justify-center text-stone-400 hover:text-stone-600 dark:text-stone-400 dark:hover:text-stone-300"
                                aria-label="<%= copy_label_for(entry) %>">
                          <span class="material-icons" style="font-size:14px" aria-hidden="true">content_copy</span>
                        </button>
                      </li>
                    <% end %>
                  </ul>
                </section>
              <% end %>
            <% end %>
          </div>
        </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
