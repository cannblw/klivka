<%= tag.div class: classes, **options do %>
  <%= render ButtonComponent.new(data: { action: "dialog#open" }) do %>
    <%= t("people.index.add_person") %>
  <% end %>

  <div data-controller="disclosure" data-action="keydown.esc->disclosure#closeAndFocus" class="relative">
    <%= render ButtonComponent.new(
          variant: :ghost,
          id: "people-collection-actions-trigger",
          data: { disclosure_target: "trigger", action: "disclosure#toggle" },
          aria: { controls: "people-collection-actions-panel", expanded: "false" }
        ) do %>
      <span><%= t("people.index.more_actions") %></span>
      <span class="material-icons align-middle" style="font-size: 18px" aria-hidden="true">expand_more</span>
    <% end %>

    <div id="people-collection-actions-panel" data-disclosure-target="panel"
         class="absolute right-0 z-40 mt-1 hidden w-56 rounded-lg border border-stone-200 bg-stone-50 py-1 shadow-lg dark:border-stone-700 dark:bg-stone-800">
      <%= render ButtonComponent.new(
            variant: :ghost,
            class: "w-full",
            style: "text-align: left",
            data: { action: "disclosure#close people-creation-dialog#toggle dialog#open" }
          ) do %>
        <%= t("people.index.add_multiple") %>
      <% end %>
      <% unless demo_mode? %>
        <%= link_to t("people.index.import_contacts"), helpers.new_vcard_import_path,
              class: menu_item_classes %>
      <% end %>
      <%= link_to t("people.index.archived_people"), helpers.archived_people_path,
            class: menu_item_classes %>
    </div>
  </div>
<% end %>
