<div data-controller="friend-autocomplete"
     data-friend-autocomplete-url-value="<%= friend_suggestions_categories_path(category_id: category.id) %>"
     data-friend-autocomplete-delay-value="<%= Rails.application.config.x.friend_search_debounce_milliseconds %>"
     data-friend-autocomplete-no-results-value="<%= t("categories.organizer.no_results") %>"
     data-friend-autocomplete-current-category-value="<%= t("categories.organizer.current_category", category: "__CATEGORY__") %>"
     data-friend-autocomplete-results-value="<%= t("categories.organizer.results", count: "__COUNT__") %>"
     data-friend-autocomplete-loading-value="<%= t("categories.organizer.loading") %>"
     data-friend-autocomplete-error-value="<%= t("categories.organizer.error") %>"
     class="relative max-w-xl">
  <label for="category-<%= category.id %>-friend-search" class="block text-sm font-medium text-stone-700 dark:text-stone-200">
    <%= t("categories.organizer.add_friend") %>
  </label>
  <input id="category-<%= category.id %>-friend-search" type="search" autocomplete="off"
         role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="<%= listbox_id %>"
         placeholder="<%= t("categories.organizer.search_placeholder") %>"
         data-friend-autocomplete-target="input"
         data-action="input->friend-autocomplete#search keydown->friend-autocomplete#keydown blur->friend-autocomplete#blur"
         class="mt-1 <%= FormStyling::INPUT_CLASSES %> w-full">
  <ul id="<%= listbox_id %>" role="listbox" data-friend-autocomplete-target="list"
      class="absolute z-30 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-lg border border-stone-200 bg-stone-50 p-1 shadow-lg dark:border-stone-700 dark:bg-stone-800"></ul>
  <p data-friend-autocomplete-target="status" class="sr-only" aria-live="polite"></p>

  <%= form_with url: categories_path, method: :patch, scope: :category_assignment,
        data: { friend_autocomplete_target: "form" }, class: "hidden" do |form| %>
    <%= form.hidden_field :category_id, value: category.id %>
    <%= form.hidden_field :return_to, value: "categories" %>
  <% end %>
</div>
