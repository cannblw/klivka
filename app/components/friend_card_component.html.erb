<%= link_to friend, class: "block rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:shadow-md dark:border-gray-700 dark:bg-gray-800 dark:hover:shadow-lg dark:hover:shadow-gray-900/30" do %>
  <div class="flex aspect-square items-center justify-center rounded-lg bg-indigo-100 text-4xl font-semibold text-indigo-600 dark:bg-indigo-800 dark:text-indigo-200">
    <%= initials %>
  </div>
  <p class="mt-3 truncate text-center font-medium"><%= friend.name %></p>
<% end %>
