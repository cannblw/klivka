<%= link_to friend, class: "block rounded-xl border border-stone-200 bg-stone-50 p-4 shadow-sm transition hover:shadow-md dark:border-stone-700 dark:bg-stone-800 dark:hover:shadow-lg dark:hover:shadow-stone-900/30" do %>
  <div class="flex aspect-square items-center justify-center rounded-lg bg-amber-100 text-4xl font-semibold text-amber-700 dark:bg-amber-800 dark:text-amber-200">
    <%= initials %>
  </div>
  <p class="mt-3 truncate text-center font-medium"><%= friend.name %></p>
<% end %>
