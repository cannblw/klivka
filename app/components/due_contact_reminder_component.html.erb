<li class="py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <%= link_to person.name, helpers.person_path(person, from: "reminders"), class: "block truncate text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
      <p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400"><%= t("reminders.ready_since", date: l(reminder_on, format: :long)) %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= render QuickInteractionComponent.new(
            person:, interaction:, time_zone:, open: open?, dom_id: dialog_id,
            button_label: t("reminders.contact.contact_today"), return_to: "reminders"
          ) %>
      <%= form_with url: helpers.snooze_person_keep_in_touch_setting_path(person), method: :patch, scope: :keep_in_touch_setting do |form| %>
        <%= hidden_field_tag :return_to, "reminders" %>
        <%= render ButtonComponent.new(variant: :ghost, type: :submit, size: :sm) do %>
          <%= t("reminders.contact.snooze") %>
        <% end %>
      <% end %>
    </div>
  </div>
</li>
