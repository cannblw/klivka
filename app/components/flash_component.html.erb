<div data-controller="toast" data-toast-duration-value="5000" role="<%= role %>"
     class="pointer-events-auto flex w-full select-none items-center gap-3 rounded-lg <%= background_class %> px-4 py-3 text-sm font-medium text-white shadow-lg transition duration-200 sm:w-auto sm:min-w-96 sm:max-w-lg sm:px-5 sm:py-4">
  <p class="flex-1"><%= message %></p>

  <button type="button" data-action="toast#dismiss" aria-label="<%= t("flash.dismiss") %>"
          class="relative grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded-full hover:bg-white/10">
    <svg class="absolute inset-0 h-8 w-8 -rotate-90" viewBox="0 0 32 32" aria-hidden="true">
      <circle data-toast-target="ring" cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2" class="text-white/70"/>
    </svg>
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" d="m6 6 8 8m0-8-8 8"/>
    </svg>
  </button>
</div>
