<div data-controller="file-field" data-file-field-empty-name-value="<%= empty_label %>">
  <label for="<%= field_id %>" class="block text-sm font-medium text-stone-700 dark:text-stone-200"><%= label %></label>
  <p id="<%= hint_id %>" class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= hint %></p>

  <div class="mt-3 rounded-lg border border-stone-300 bg-white transition focus-within:border-brand-focus focus-within:ring-1 focus-within:ring-brand-focus dark:border-stone-600 dark:bg-stone-900">
    <%= form.file_field field,
          id: field_id,
          accept:,
          aria: { describedby: "#{hint_id} #{filename_id}" },
          data: { file_field_target: "input", action: "change->file-field#update" },
          class: "sr-only" %>
    <label for="<%= field_id %>" class="flex cursor-pointer flex-col gap-2 rounded-lg px-3 py-3 sm:flex-row sm:items-center">
      <span class="w-fit shrink-0 rounded-md bg-stone-200 px-3 py-1.5 text-sm font-medium text-stone-700 dark:bg-stone-700 dark:text-stone-100"><%= choose_label %></span>
      <span id="<%= filename_id %>" data-file-field-target="name" aria-live="polite" class="min-w-0 truncate text-sm text-stone-500 dark:text-stone-400"><%= empty_label %></span>
    </label>
  </div>

  <% if form.object.respond_to?(:errors) %>
    <% form.object.errors.full_messages_for(field).each do |message| %>
    <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  <% end %>
</div>
