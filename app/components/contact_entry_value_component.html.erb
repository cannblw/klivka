<% if value.present? %>
  <span class="inline-flex items-center gap-1">
    <%= link_to value, href, class: "text-sm font-medium text-amber-700 dark:text-amber-400" %>
    <button type="button"
            data-controller="clipboard"
            data-clipboard-text-value="<%= value %>"
            data-action="click->clipboard#copy"
            class="inline-flex size-6 cursor-pointer items-center justify-center text-stone-400 hover:text-stone-600 dark:text-stone-400 dark:hover:text-stone-300"
            aria-label="<%= copy_label %>">
      <span class="material-icons" style="font-size:14px" aria-hidden="true">content_copy</span>
    </button>
  </span>
  <% if label.present? %>
    <span class="ml-2 rounded-full bg-stone-200 px-2 py-0.5 text-xs text-stone-600 dark:bg-stone-700 dark:text-stone-300"><%= label %></span>
  <% end %>
<% end %>
