<li class="py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="truncate text-sm font-medium text-stone-900 dark:text-stone-100"><%= label %></p>
      <%= link_to person.name, person_path, class: "mt-0.5 block truncate text-sm text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
      <p class="mt-0.5 text-sm text-stone-600 dark:text-stone-300"><%= t("reminders.date.occurs_on", date: l(occurrence_on, format: :long)) %></p>
      <p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400"><%= t("reminders.ready_since", date: l(reminder_on, format: :long)) %></p>
    </div>

    <%= link_to t("reminders.date.view"), person_path, class: "self-start rounded-lg px-3 py-1.5 text-sm font-medium text-stone-600 hover:bg-stone-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 sm:self-auto dark:text-stone-300 dark:hover:bg-stone-700" %>
  </div>
</li>
