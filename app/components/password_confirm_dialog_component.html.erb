<dialog id="<%= id %>" aria-labelledby="<%= title_id %>" aria-describedby="<%= body_id %>"
        data-controller="dialog password-confirm-dialog"
        data-dialog-target="dialog"
        data-dialog-open-value="<%= open %>"
        data-action="click->dialog#closeOnBackdrop"
        class="m-auto w-full max-w-sm rounded-xl p-0 shadow-xl backdrop:bg-stone-900/50 dark:bg-stone-800">
  <div class="p-6">
    <h2 id="<%= title_id %>" class="text-lg font-semibold dark:text-stone-100"><%= title %></h2>
    <p id="<%= body_id %>" class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= body %></p>

    <div class="mt-4">
      <%= label_tag password_id, password_label, class: "block text-sm font-medium text-stone-700 dark:text-stone-200" %>
      <p id="<%= password_hint_id %>" class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= password_hint %></p>
      <%= password_field_tag password_name, nil,
            id: password_id,
            form: form_id,
            required: true,
            autocomplete: "current-password",
            aria: { describedby: "#{password_hint_id} #{error_id}" },
            data: { password_confirm_dialog_target: "password", action: "input->password-confirm-dialog#input" },
            class: "#{FormStyling::INPUT_CLASSES} mt-2" %>
      <p id="<%= error_id %>" role="alert" <%= "hidden" unless error %>
         data-password-confirm-dialog-target="error"
         class="mt-2 text-sm text-red-600 dark:text-red-400"><%= error %></p>
    </div>

    <div class="mt-5 flex justify-end gap-2">
      <%= render ButtonComponent.new(variant: :ghost, data: { action: "dialog#close" }) do %>
        <%= cancel_label %>
      <% end %>
      <%= render ButtonComponent.new(type: :submit, variant: :destructive, form: form_id, id: "#{id}-confirm") do %>
        <%= confirm_label %>
      <% end %>
    </div>
  </div>
</dialog>
