<%= form_with model: [ friend, interaction ],
      data: { interaction_date_target: "form", action: "submit->interaction-date#submit" },
      class: "space-y-4" do |form| %>
  <div>
    <%= form.label :occurred_on, t("interactions.follow_up.occurred_on"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
    <div class="relative mt-1">
      <%= form.date_field :occurred_on, required: true, max: Date.current,
            data: { interaction_date_target: "date" },
            class: "interaction-date-input w-full rounded-lg border border-stone-300 bg-stone-50 px-3 py-2 pr-10 text-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-100" %>
      <button type="button"
              data-action="interaction-date#openPicker"
              aria-label="<%= t("interactions.follow_up.occurred_on") %>"
              class="absolute inset-y-0 right-3 flex items-center text-stone-500 dark:text-stone-300">
        <span class="material-icons" style="font-size: 20px" aria-hidden="true">calendar_today</span>
      </button>
    </div>
    <% interaction.errors.full_messages_for(:occurred_on).each do |message| %>
      <p class="mt-1 text-sm text-red-600"><%= message %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :contact_method, t("interactions.follow_up.contact_method"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
    <%= render SelectFieldComponent.new(form, :contact_method,
          choices: contact_method_options,
          selected: interaction.contact_method,
          select_options: { include_blank: t("interactions.follow_up.method_blank") },
          wrapper_class: "mt-1") %>
  </div>

  <div>
    <%= form.label :note, t("interactions.follow_up.note"), class: "block text-sm font-medium text-stone-700 dark:text-stone-300" %>
    <%= form.text_area :note, rows: 4, placeholder: t("interactions.follow_up.note_placeholder"),
          class: "mt-1 w-full resize-none rounded-lg border border-stone-300 bg-stone-50 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-100" %>
  </div>

  <div class="flex gap-2">
    <%= render ButtonComponent.new(type: :submit) do %>
      <%= t("interactions.form.save") %>
    <% end %>
    <%= link_to t("interactions.follow_up.cancel"), friend, class: "rounded-lg px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-700" %>
  </div>
<% end %>
