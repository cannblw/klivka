<li class="py-3" data-filter-list-target="item" data-search-value="<%= person.name %>">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <%= link_to person.name, helpers.person_path(person), data: { turbo_frame: "_top" }, class: "block truncate text-sm font-medium text-amber-700 hover:text-amber-600 dark:text-amber-400 dark:hover:text-amber-300" %>
      <p class="mt-0.5 text-xs text-stone-500 dark:text-stone-400" data-contact-reminder-state><%= state_label %></p>
    </div>

    <%= form_with url: helpers.contact_reminder_path(person), method: :patch, scope: :contact_reminder, class: "flex w-full items-end gap-2 sm:w-auto" do |form| %>
      <div class="min-w-0 flex-1 sm:w-64">
        <%= form.label :selection, t("contact_reminders.organizer.setting_for", name: person.name), for: selection_id, class: "sr-only" %>
        <%= render SelectFieldComponent.new(form, :selection, choices:, selected: selected_value, id: selection_id) %>
      </div>
      <%= render ButtonComponent.new(type: :submit, size: :sm) do %>
        <%= t("contact_reminders.organizer.save") %>
      <% end %>
    <% end %>
  </div>
</li>
