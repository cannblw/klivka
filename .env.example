# Copy to .env for local overrides. All variables are optional.

# Require newly registered users to confirm their email address before they can sign in.
# Defaults to false, which suits most self-hosted setups.
# Enabling this requires working SMTP settings in production (config.action_mailer).
REQUIRE_EMAIL_CONFIRMATION=false

# Timezone used only when a user has not yet supplied one. Defaults to UTC.
# DEFAULT_TIME_ZONE=UTC

# Maximum number of friends shown for a non-empty search. Defaults to 50.
# FRIEND_SEARCH_MAX_RESULTS=50

# Milliseconds to wait after typing before searching. Defaults to 200.
# FRIEND_SEARCH_DEBOUNCE_MILLISECONDS=100

# Default reminder delivery channels for new accounts. Both default to true.
# REMINDER_DEFAULT_IN_APP_ENABLED=true
# REMINDER_DEFAULT_EMAIL_ENABLED=true

# Default advance notice for new accounts. Valid units are days, months (30 days), and years (365 days).
# REMINDER_DEFAULT_LEAD_VALUE=1
# REMINDER_DEFAULT_LEAD_UNIT=months

# Number of one account's reminder sources loaded at a time while scheduling. Defaults to 100.
# REMINDER_SCAN_BATCH_SIZE=100

# Enable the shared public demo account. Defaults to false.
# DEMO_MODE=false

# Account used by the shared public demo. Defaults to demo@klivka.com.
# DEMO_USER_EMAIL_ADDRESS=demo@klivka.com

# Demo data resets after this age only when visitors have been idle for the configured period.
# DEMO_RESET_MINIMUM_AGE_HOURS=24
# DEMO_RESET_IDLE_MINUTES=30

# Reset demo data even during continuous activity after this age.
# DEMO_RESET_MAXIMUM_AGE_HOURS=72
# DEMO_RESET_CHECK_INTERVAL_MINUTES=15

# Per-IP cap for non-GET requests in demo mode.
# DEMO_MUTATION_RATE_LIMIT=120
# DEMO_MUTATION_RATE_WINDOW_MINUTES=10
