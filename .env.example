# Copy to .env for local overrides. All variables are optional.

# Require newly registered users to confirm their email address before they can sign in.
# Defaults to false, which suits most self-hosted setups.
# Enabling this requires working SMTP settings in production (config.action_mailer).
REQUIRE_EMAIL_CONFIRMATION=false

# Timezone used only when a user has not yet supplied one. Defaults to UTC.
# DEFAULT_TIME_ZONE=UTC

# Credentials for the mock-data account created by db:seed in development.
# DEVELOPMENT_SEED_EMAIL_ADDRESS=
# DEVELOPMENT_SEED_PASSWORD=

# Maximum number of people shown for a non-empty search. Defaults to 50.
# PERSON_SEARCH_MAX_RESULTS=50

# Milliseconds to wait after typing before searching. Defaults to 100.
# PERSON_SEARCH_DEBOUNCE_MILLISECONDS=100

# Maximum number of recent interactions shown on a person's profile. Defaults to 3.
# INTERACTION_PROFILE_PREVIEW_LIMIT=3

# The maximum file size is expressed in bytes. Its default is 5 MiB.
# VCARD_IMPORT_MAX_FILE_SIZE_BYTES=5242880
# VCARD_IMPORT_MAX_CARDS=5000
# VCARD_IMPORT_PREVIEW_LIFETIME_HOURS=1
# Maximum uploads per user within the rate-limit window. Defaults to 10 uploads per 60 minutes.
# VCARD_IMPORT_UPLOAD_RATE_LIMIT=10
# VCARD_IMPORT_UPLOAD_RATE_WINDOW_MINUTES=60

# The maximum Klivka JSON import size is expressed in bytes. Its default is 25 MiB.
# ACCOUNT_IMPORT_MAX_FILE_SIZE_BYTES=26214400
# Maximum import requests per user within the rate-limit window. Defaults to 3 requests per minute.
# ACCOUNT_IMPORT_UPLOAD_RATE_LIMIT=3
# ACCOUNT_IMPORT_UPLOAD_RATE_WINDOW_MINUTES=1

# Base URL used in reminder email links. Defaults to the local development URL.
# APPLICATION_URL=http://localhost:3000

# Sender used for application email. Defaults to a placeholder suitable for local testing.
# MAIL_FROM="Klivka <from@example.com>"

# Reminder email transport. Rails uses the configured Action Mailer delivery method.
# REMINDER_MAIL_TRANSPORT=rails

# Number of delivery attempts and minutes before an abandoned claim can be retried.
# REMINDER_DELIVERY_RETRY_ATTEMPTS=5
# REMINDER_DELIVERY_CLAIM_TIMEOUT_MINUTES=30

# Number of attempts for cleaning up account-owned resources outside the database. Defaults to 5.
# ACCOUNT_DELETION_CLEANUP_RETRY_ATTEMPTS=5

# Required when REMINDER_MAIL_TRANSPORT=resend. Provide it as a deployment secret.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default reminder delivery channels for new accounts. Both default to true.
# REMINDER_DEFAULT_IN_APP_ENABLED=true
# REMINDER_DEFAULT_EMAIL_ENABLED=true
# BIRTHDAY_REMINDER_DEFAULT_ENABLED=true

# Default advance notice for new accounts. Valid units are days, months (30 days), and years (365 days).
# REMINDER_DEFAULT_LEAD_VALUE=1
# REMINDER_DEFAULT_LEAD_UNIT=months

# Number of one account's reminder sources loaded at a time while scheduling. Defaults to 100.
# REMINDER_SCAN_BATCH_SIZE=100

# Accounts loaded per dispatcher batch, reminder worker threads per process, and dispatcher frequency.
# REMINDER_ACCOUNT_BATCH_SIZE=500
# REMINDER_JOB_THREADS=5
# REMINDER_DISPATCH_INTERVAL_MINUTES=60

# Local hour when daily contact reminder digests become eligible to send. Defaults to 08:00.
# CONTACT_REMINDER_DIGEST_HOUR=8
# Maximum number of people previewed in a contact reminder digest email. Defaults to 5.
# CONTACT_REMINDER_DIGEST_PREVIEW_LIMIT=5

# Number of worker processes started for each Solid Queue worker group. Defaults to 1.
# JOB_CONCURRENCY=1

# Enable the shared public demo account. Defaults to false.
# DEMO_MODE=false

# Account used by the shared public demo. Defaults to demo@klivka.com.
# DEMO_USER_EMAIL_ADDRESS=demo@klivka.com

# Demo data resets after this age only when visitors have been idle for the configured period.
# DEMO_RESET_MINIMUM_AGE_HOURS=24
# DEMO_RESET_IDLE_MINUTES=30

# Reset demo data even during continuous activity after this age.
# DEMO_RESET_MAXIMUM_AGE_HOURS=72
# DEMO_RESET_CHECK_INTERVAL_MINUTES=15

# Per-IP cap for non-GET requests in demo mode.
# DEMO_MUTATION_RATE_LIMIT=120
# DEMO_MUTATION_RATE_WINDOW_MINUTES=10
